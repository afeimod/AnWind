+# ---------- v3.3.1：陈旧/冻结 wineserver 硬清理 ----------
+# 根因：wineserver 守护在 server 侧 open_master_socket() 里 setsid() 脱离
+# 会话树后自管生命周期 —— 不在 App/终端会话的进程组里：上次会话被杀 /
+# Android cgroup freezer 冻结后台应用全组时，它以“socket 仍在监听、
+# 但进程永不应答”的形态残留。新 wine 客户端发现 socket 已存在 →
+# 不再拉起新 server → connect 成功（内核 backlog）→ 阻塞在握手
+# receive_fd() 的 recvmsg() 上：无输出、无退出码、system.reg 永不落盘
+# —— proton arm64ec 前缀构建“无任何输出挂死”的直接载体。
+# wineserver -k 救不了（-k 客户端同样阻塞）。此处按 /proc 硬清理：
+# cwd 在 $WINEPREFIX/.wineserver/ 下的 wineserver 一律 SIGKILL，再删掉
+# .wineserver 残留 socket/lock（新 server 启动时上游 acquire_lock 自行
+# 重建）。仅用 cwd 判据：wineserver 守护启动时 chdir 进 server 目录且
+# 永不离开（上游 create_server_dir），这是“属于本前缀”的权威特征 ——
+# 绝不能按 cmdline 含 wine 目录兜底：同 wine 安装跑多个容器时那会误杀
+# 别的前缀的活 server；-k/-w 客户端等瞬态进程 cwd 不在 server 目录，
+# 天然不命中。
+# 幂等；无 .wineserver 目录（全新前缀）时零成本直接返回。
+clean_stale_wineserver() {
+    [ -d "$WINEPREFIX/.wineserver" ] || return 0
+    local _dir _pid _cmd _cwd _killed=0 _sock=0
+    for _dir in /proc/[0-9]*; do
+        [ -r "${_dir}/cmdline" ] || continue
+        _pid="${_dir#/proc/}"
+        [ "$_pid" != "$$" ] || continue
+        _cmd="$(tr '\0' ' ' < "${_dir}/cmdline" 2>/dev/null)"
+        case "$_cmd" in *wineserver*) ;; *) continue ;; esac
+        _cwd="$(readlink "${_dir}/cwd" 2>/dev/null)"
+        case "$_cwd" in
+            "$WINEPREFIX"/.wineserver/*) ;;
+            *) continue ;;
+        esac
+        if kill -9 "$_pid" 2>/dev/null; then
+            _killed=$((_killed + 1))
+            info "已清理陈旧/冻结 wineserver（pid=$_pid cwd=$_cwd）——它会阻断新客户端握手（前缀构建无输出挂死的直接载体）"
+        fi
+    done
+    # 死 server 残留（无存活进程但 socket 文件仍在）也要清 —— 否则客户端
+    # 要空转 6 次重试（约 5.5s）才报错（残留文件哪怕不是真 socket，上游
+    # 客户端也会 fatal "is not a socket"，一并清掉最稳）
+    for _dir in "$WINEPREFIX"/.wineserver/server-*/socket; do
+        [ -e "$_dir" ] && { _sock=1; break; }
+    done
+    if [ "$_killed" -gt 0 ] || [ "$_sock" -gt 0 ]; then
+        [ "$_killed" -eq 0 ] && info "检测到陈旧 wineserver socket（无存活进程），清理 $WINEPREFIX/.wineserver"
+        if [ "$_killed" -gt 0 ]; then
+            sleep 0.5 2>/dev/null || sleep 1
+        fi
+        rm -rf "$WINEPREFIX/.wineserver" 2>/dev/null || true
+    fi
+    return 0
+}
