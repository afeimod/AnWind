#            另：--debug 诊断模式（WINEDEBUG=+seh,+module,err+vulkan,
#            err+wgl）；bionic 下不再导出 LC_ALL（消除 setlocale 噪音）；
#            旧版内置 hangover 兜底时给出显式升级提示。
# ★ 隔离版（assets 分发，App 启动时覆盖安装到 rootfs/usr/bin）★
# ------------------------------------------------------------
# 职责：
#   1. 解析容器（~/.anwind/containers/<name>）与 WINEPREFIX
#   2. 全量环境隔离 —— 容器运行不受 Termux（anwind 终端）数据环境
#      影响：PREFIX/HOME/TMPDIR/LD_LIBRARY_PATH/LANG/音频/XDG 全部
#      切换到 rootfs 自己的一套，并清洗终端侧注入的残留变量
#   3. 音频自持 —— 优先拉起 rootfs 自带 PulseAudio（unix socket，
#      module-sles-sink 直连 Android 音频），不挂靠 Termux 侧 4713
#   4. 依容器配置与 wine 二进制 ELF 架构自动选后端：
#        arm64ec  : aarch64 wine 直接原生运行（new WoW64，无需模拟器）
#        box64    : box64 + x86_64 wine（/usr/opt/<wine>，主力路径）
#        hangover : 旧版兼容（aarch64 wine 在 /usr/opt/bin，qemu 模拟）
#        fexcore  : FEX-Emu（FEXInterpreter）+ x86_64 wine
#        native   : x86_64 设备直接运行（无模拟器）
#      后端识别按 $WINE_DIR/bin/wine 的 ELF 头（e_machine）自动判定：
#      bionic-arm64ec 构建与 bionic-x86_64 构建装在任意槽位均可直接用
#   5. X 服务自启（v2.1 核心）：启动 wine 前检查 X socket，缺失则
#      后台拉起内置 termux-x11（与 anwind-x11 同源），DISPLAY 一律
#      强制 :1（ANWIND_DISPLAY 可覆盖）—— 终端里直接跑
#        wine notepad
#      即可出画面，不再需要先手敲 anwind-x11 :1 && env DISPLAY=:1
#   5. Wine 多版本：容器 wine= 选 /usr/opt/<name>（anwind-container
#      wine-list 可见；空 = 全局 default_wine，再空 = /usr/opt/wine）
#   6. 显示模式 dmode（对齐 glibc-runner -d/-v/-f）：
#        off : 跟随 X11 窗口（native，桌面会话默认）
#        d   : 固定 X 屏幕分辨率（-d，游戏真实全屏渲染 + 贴合拉伸）
#        v   : wine 虚拟桌面 explorer /desktop（-v，DDraw 老游戏）
#        f   : 强制窗口直出（-f，清除注册表 wine 蓝底桌面）
#   7. 首次运行自动 wineboot -i 初始化前缀
#
# 用法：
#   anwind-wine [--container <name>] <wine 参数...>
#   anwind-wine --list-backends
#   环境变量 ANWIND_CONTAINER=<name> 可代替 --container
#   rootfs/usr/bin/wine|winecfg|wineboot|regedit 均为本脚本的包装器
#
# 显示（重要）：本 rootfs 为 X11 方案。X 服务为 AnWind 内置
# termux-x11/libXlorie，unix socket 在 App 侧
#   /data/data/com.anwind/files/usr/tmp/.X11-unix/Xn
# rootfs 内 libxcb/xtrans/libX11 已按该路径打补丁，因此只需
# 设好 DISPLAY —— 一律强制 DISPLAY=:1（ANWIND_DISPLAY 可覆盖）。
# v2.1 起 X 服务未运行时由本脚本自动拉起（socket 探测），
# 用户不再需要先手敲 anwind-x11 :1。
# ============================================================

# ---------- 基础路径（与 bionic-rootfs/default.conf 一致） ----------
RFS_ROOT="/data/data/com.anwind/files/rootfs"
RFS_USR="$RFS_ROOT/usr"
APP_PREFIX="/data/data/com.anwind/files/usr"
CONT_ROOT="$RFS_ROOT/home/.anwind/containers"
CONF_GLOBAL="$RFS_USR/etc/anwind/container.conf"
X11_SOCK_DIR="$APP_PREFIX/tmp/.X11-unix"
LOG_DIR="$CONT_ROOT/logs"

version() { echo "anwind-wine 2.7.0 (AnWind bionic rootfs, X11 auto-start, isolated env, emulate-modeset, session log, zink GL, robust wineboot, soname self-heal)"; }

# ---------- SONAME 版本别名自愈（v2.7） ----------
# 背景：本构建系统按 Termux/bionic 惯例产无版本号 .so，而 wine 的 unix
# 模块（winex11 等）DT_NEEDED 记上游标准 SONAME（libX11.so.6 等）。
# 20261025 之前的 rootfs 没打版本别名 → wine 的 .so 加载失败 →
# "驱动加载不了" / wineboot 启动崩溃 / exe 无声无息（设备日志
# wine-1111 / wine-5555 的间接成因之一）。别名映射与
# bionic-rootfs/make-rootfs.sh 保持一致（新 rootfs 已在组装时打好，
# 此处幂等补建，专为旧 rootfs 存量设备自愈）。
fix_soname_aliases() {
    local _fixed=0 _base _soname _v
    # X11 系 / mesa 系：无版本 .so → 上游标准 SONAME 别名
    while IFS='|' read -r _base _soname; do
        [ -n "$_base" ] || continue
        if [ -e "$RFS_USR/lib/$_base" ] && [ ! -e "$RFS_USR/lib/$_soname" ]; then
            ln -sf -- "$_base" "$RFS_USR/lib/$_soname" 2>/dev/null && _fixed=$((_fixed + 1))
        fi
    done <<'SONAME_MAP'
libX11.so|libX11.so.6
libX11-xcb.so|libX11-xcb.so.1
libXext.so|libXext.so.6
libXrender.so|libXrender.so.1
libXfixes.so|libXfixes.so.3
libXrandr.so|libXrandr.so.2
libXi.so|libXi.so.6
libXcursor.so|libXcursor.so.1
libXinerama.so|libXinerama.so.1
libXcomposite.so|libXcomposite.so.1
libXxf86vm.so|libXxf86vm.so.1
libXv.so|libXv.so.1
libXdamage.so|libXdamage.so.1
libxshmfence.so|libxshmfence.so.1
libXau.so|libXau.so.6
libXdmcp.so|libXdmcp.so.6
libxkbcommon.so|libxkbcommon.so.0
libxkbcommon-x11.so|libxkbcommon-x11.so.0
libdrm.so|libdrm.so.2
libdrm_amdgpu.so|libdrm_amdgpu.so.1
libdrm_freedreno.so|libdrm_freedreno.so.1
libGL.so|libGL.so.1
libEGL.so|libEGL.so.1
libGLESv2.so|libGLESv2.so.2
libgbm.so|libgbm.so.1
SONAME_MAP
    # libxcb 核心与扩展库（上游 -version-info：核心/sync/xkb → .1，其余 → .0）
    for _f in "$RFS_USR"/lib/libxcb*.so; do
        [ -f "$_f" ] || continue
        _base="$(basename "$_f")"
        case "$_base" in
            libxcb.so|libxcb-sync.so|libxcb-xkb.so) _v=1 ;;
            *) _v=0 ;;
        esac
        if [ ! -e "$RFS_USR/lib/$_base.$_v" ]; then
            ln -sf -- "$_base" "$RFS_USR/lib/$_base.$_v" 2>/dev/null && _fixed=$((_fixed + 1))
        fi
    done
    [ "$_fixed" -gt 0 ] && info "SONAME 自愈: 补建 $_fixed 个版本别名软链（旧 rootfs 修复；详见 ls $RFS_USR/lib/libX11.so.6 等）"
    return 0
}

# ---------- box64 版本探测（v2.7） ----------
# 回显纯数字版本号（0.4.4）；探测失败回显空。box64 --version 首行
# 形如 "box64 v0.4.4 built on ..."。
box64_version() {
    local _bin="$1" _v
    [ -n "$_bin" ] && [ -x "$_bin" ] || { echo ""; return 0; }
    _v="$("$_bin" --version 2>/dev/null | head -n 1 | grep -o '[0-9][0-9]*\.[0-9][0-9]*\(\.[0-9][0-9]*\)\?' | head -n 1)"
    printf '%s' "$_v"
}

# 版本比较：$1 < $2 回 0（真），否则非 0。形如 0.4.2 / 0.4.4 / 0.5。
# 纯 shell 实现（不依赖 sort -V —— bionic 侧 coreutils 裁剪不确定）：
# 逐段数值比较，段数不同时长者补 0。
ver_lt() {
    local _a="$1" _b="$2" _ai _bi _i
    [ -n "$_a" ] || return 0          # 空版本视为最小
    [ -n "$_b" ] || return 1
    _a="${_a#v}"; _b="${_b#v}"
    local IFS='.'
    _ai=( $_a ); _bi=( $_b )
    for _i in 0 1 2 3 4; do
        local _x="${_ai[$_i]:-0}" _y="${_bi[$_i]:-0}"
        _x=$(( ${_x:-0} + 0 )) 2>/dev/null || _x=0
        _y=$(( ${_y:-0} + 0 )) 2>/dev/null || _y=0
        [ "$_x" -lt "$_y" ] && return 0
        [ "$_x" -gt "$_y" ] && return 1
    done
    return 1
}

# ---------- 运行时目录兜底（必须在任何 wine 调用前） ----------
# wine 按 termux 风格构建，把 /tmp 硬编码为 $RFS_USR/tmp：wineserver 启动时
# 要在其下创建 .wine-<uid> 运行时目录；X11 socket 在 App 侧 tmp/.X11-unix。
mkdir -p "$RFS_USR/tmp" "$APP_PREFIX/tmp/.X11-unix" "$LOG_DIR" "$RFS_ROOT/home" 2>/dev/null || true

die() { echo "anwind-wine: $*" >&2; exit 1; }
info() {
    echo "[anwind-wine] $*"
    # 进程替换不可用的降级路径：手工把决策信息追加进日志文件
    if [ "${ANWIND_LOG_NO_TEE:-0}" = "1" ] && [ -n "${ANWIND_LOG_FILE:-}" ]; then
        printf '[anwind-wine] %s\n' "$*" >>"$ANWIND_LOG_FILE" 2>/dev/null || true
    fi
}

# ---------- 会话日志（v2.4：wine/exe 全程留痕，排障不再靠猜） ----------
# 位置优先级：
#   1) ANWIND_SESSION_LOG —— App 会话（WineSessionLauncher.spawn）已建好
#      日志文件并把整条会话（bash→anwind-container→本脚本→wine）的输出
#      tee 接到该文件；此时只复用该文件、不再自建 tee（避免双写）。
#   2) /storage/emulated/0/Download/AnWind/wine-<容器>-<时间>.log ——
#      公共 Download，用户文件管理器可直接取走（需「所有文件访问」授权）
#   3) $LOG_DIR/wine-<容器>-<时间>.log —— rootfs 容器区 logs/，永远可写
# 内容：环境决策链（容器/后端/wine 形态/WINEPREFIX/音频/GPU）+ wine
#       原始 stdout/stderr 全程落盘；终端同步回显不受影响。
ANWIND_LOG_FILE=""
ANWIND_LOG_NO_TEE=0

rotate_logs() { # <目录> [保留数] —— 只清理本机制产生的 wine-*.log
    local _dir="$1" _keep="${2:-30}" _old
    [ -d "$_dir" ] || return 0
    _old="$(ls -t "$_dir"/wine-*.log 2>/dev/null | tail -n +$((_keep + 1)))"
    if [ -n "$_old" ]; then
        printf '%s\n' "$_old" | xargs -r rm -f 2>/dev/null
    fi
    return 0
}

session_log_init() {
    local _ts _name _f _dir
    # 1) App 会话已建文件 → 复用
    if [ -n "${ANWIND_SESSION_LOG:-}" ] && : >> "$ANWIND_SESSION_LOG" 2>/dev/null; then
        ANWIND_LOG_FILE="$ANWIND_SESSION_LOG"
        return 0
    fi
    # 2) / 3) 自建（终端直跑 wine / anwind-container run 场景）
    _ts="$(date '+%Y%m%d-%H%M%S' 2>/dev/null || echo manual)"
    _name="$(printf '%s' "${CONT_NAME:-default}" | tr -c 'A-Za-z0-9._-' '_' 2>/dev/null | cut -c1-40)"
    [ -n "$_name" ] || _name="default"
    for _dir in "/storage/emulated/0/Download/AnWind" "$LOG_DIR"; do
        mkdir -p "$_dir" 2>/dev/null || true
        _f="$_dir/wine-${_name}-${_ts}.log"
        if : >> "$_f" 2>/dev/null; then
            ANWIND_LOG_FILE="$_f"
            printf '===== AnWind wine 会话 %s =====\n' \
                "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo '?')" >>"$_f" 2>/dev/null || true
            rotate_logs "$_dir"
            break
        fi
    done
    return 0
}

# 把整条输出接到日志文件（终端照常回显）。用进程替换保留 exec 语义：
# wine 仍是本进程替换而来（会话 pid / 信号 / kill 行为全部不变）；
# 环境不支持进程替换（无 /dev/fd 且 FIFO 兜底失败）时自动退回原直跑
# 行为（仅 info 决策行直接落盘，零风险降级）。
session_log_attach() {
    [ -n "$ANWIND_LOG_FILE" ] || return 0
    # ANWIND_SAFE 基线对照模式：输出直连终端（不经 tee 管道），决策行
    # 仍经 info() 手工落盘 —— 排障信息不丢
    if [ "${ANWIND_SAFE:-0}" = "1" ]; then
        ANWIND_LOG_NO_TEE=1
        return 0
    fi
    [ -n "${ANWIND_SESSION_LOG:-}" ] && return 0   # App 侧已在会话顶层接管
    command -v tee >/dev/null 2>&1 || { ANWIND_LOG_NO_TEE=1; return 0; }
    if bash -c ': > >(true)' 2>/dev/null; then
        exec > >(tee -a "$ANWIND_LOG_FILE") 2>&1
    else
        ANWIND_LOG_NO_TEE=1
    fi
    return 0
}

