# ---------- 配置读取 ----------
conf_read() { # <file> <key> [default]
    local _v=""
    [ -r "$1" ] && _v="$(sed -n "s/^$2=//p" "$1" | head -n 1 | tr -d '\r')"
    if [ -z "$_v" ] && [ -n "${3:-}" ]; then _v="$3"; fi
    printf '%s' "$_v"
}

# ============================================================
# 环境隔离（核心）—— 容器只认 rootfs 自己的一套
# ============================================================
isolate_env() {
    # --- 1) 清洗终端侧注入的残留变量 ---
    # LD_PRELOAD（termux-exec 等）会劫持 execve，wine/box64 必炸
    unset LD_PRELOAD
    # Termux 侧标识与路径全部作废（防止容器内脚本误判前缀）
    unset TERMUX_VERSION TERMUX_APP_PACKAGE TERMUX_PREFIX TERMUX_MAIN_PACKAGE_FILENAME
    unset TERMUX_APP__TERMUX__FILES_PREFIX 2>/dev/null || true

    # --- 2) 前缀/临时目录/家目录 → rootfs 自己的 ---
    export PREFIX="$RFS_USR"
    export TMPDIR="$RFS_USR/tmp"
    export HOME="$RFS_ROOT/home"
    export XDG_RUNTIME_DIR="$RFS_USR/tmp"
    export XDG_CONFIG_HOME="$HOME/.config"
    export XDG_CACHE_HOME="$HOME/.cache"
    export XDG_DATA_HOME="$HOME/.local/share"
    mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" 2>/dev/null || true

    # --- 3) 语言 → 容器自己的（container.conf lang=，默认 zh_CN）---
    # 不再继承 Termux 会话的 LANG=en_US.UTF-8。
    # 只设 LANG 不设 LC_ALL：bionic 无 locale 数据（rootfs 的
    # locale-archive 只供 glibc 容器用），导出 LC_ALL 会触发 bash 每次启动
    # 的 "warning: setlocale: LC_ALL: cannot change locale" 噪音；
    # wine 按 LANG 识别界面语言已足够。
    local _lang
    _lang="$(conf_read "$CONT_CONF" lang "zh_CN.UTF-8")"
    [ -n "$_lang" ] || _lang="zh_CN.UTF-8"
    export LANG="$_lang"

    # --- 4) 动态库搜索路径 → 仅 rootfs（驱动/渲染库零串扰）---
    # 注意：不追加继承值（Termux 侧 lib 会污染 Mesa/ARM 驱动符号解析）
    local _lp="$RFS_USR/lib"
    [ -d "$RFS_USR/local/lib" ] && _lp="$_lp:$RFS_USR/local/lib"
    [ -d "$WINE_DIR/lib" ]      && _lp="$_lp:$WINE_DIR/lib"
    [ -d "$RFS_USR/opt/lib" ]   && _lp="$_lp:$RFS_USR/opt/lib"
    [ -d "$RFS_USR/opt/fex/lib" ] && _lp="$_lp:$RFS_USR/opt/fex/lib"
    export LD_LIBRARY_PATH="$_lp"

    # --- 5) PATH → rootfs 优先，App 前缀仅兜底（curl/zstd 等下载工具）---
    export PATH="$RFS_USR/bin:$RFS_USR/local/bin:/system/bin:/system/xbin:$APP_PREFIX/bin"

    # --- 6) X11：立即强制 :1（ANWIND_DISPLAY 可覆盖）---
    # 不再沿用继承值：Termux 会话残留的空/错 DISPLAY 会让 wine
    # 连错地方 → X11 黑屏。X 服务自启见 ensure_x11（主流程调用）。
    export DISPLAY="${ANWIND_DISPLAY:-:1}"

    # --- 7) XKB / Mesa 基础（rootfs 自带的一套）---
    export XKB_CONFIG_ROOT="${XKB_CONFIG_ROOT:-$RFS_USR/share/X11/xkb}"
    export MESA_SHADER_CACHE_DISABLE=false
    export MESA_SHADER_CACHE_MAX_SIZE=512MB
    export mesa_glthread=true
    case "$(uname -m)" in
        aarch64|arm64) export TU_DEBUG=noconform,sysmem ;;
    esac

    # --- 8) GStreamer（rootfs 自带的插件栈，wine winegstreamer 后端用）---
    # 插件路径显式指向 rootfs，防 Termux 侧 GST 变量串扰；
    # 注册表缓存 fork 在 Android 上偶发卡死，直接关掉（wine 一次性
    # 加载，非长驻服务，重建注册表的代价可接受）。
    if [ -d "$RFS_USR/lib/gstreamer-1.0" ]; then
        export GST_PLUGIN_SYSTEM_PATH="$RFS_USR/lib/gstreamer-1.0"
        export GST_REGISTRY_FORK=false
    fi
}

# ============================================================
# X 服务自启（v2.1 核心）—— 不再要求用户先手敲 anwind-x11 :1
# ============================================================
# DISPLAY 已由 isolate_env 强制 :1；此处检查对应 X socket，缺失则
# 后台拉起内置 termux-x11（CmdEntryPoint，与 anwind-x11 同源），
# 轮询等待 socket 就位（最多 ~10s，app_process 冷启动较慢）。
# 注意：X 服务进程必须用 App 侧的 XDG_RUNTIME_DIR/TMPDIR（socket
# 落在 App 侧 tmp/.X11-unix），不能用容器隔离后的 rootfs tmp ——
# 故以子 shell 覆写后 exec，不污染当前进程的容器环境。
ensure_x11() {
    local _num _sock _log
    _num="${DISPLAY#:}"; _num="${_num%%.*}"
    case "$_num" in *[!0-9]*|"") _num="1"; export DISPLAY=":1" ;; esac
    _sock="$X11_SOCK_DIR/X$_num"
    [ -S "$_sock" ] && return 0
    _log="$APP_PREFIX/tmp/anwind-x11-autostart.log"
    mkdir -p "$APP_PREFIX/tmp" 2>/dev/null || true
    info "X 服务无 socket X$_num，自动拉起内置 X 服务（显示号 :$_num）……"
    if [ -x "$APP_PREFIX/bin/termux-x11" ]; then
        ( export XDG_RUNTIME_DIR="$APP_PREFIX/tmp" TMPDIR="$APP_PREFIX/tmp"
          export PATH="$APP_PREFIX/bin:/system/bin"
          exec "$APP_PREFIX/bin/termux-x11" ":$_num" >>"$_log" 2>&1 ) &
        disown 2>/dev/null || true
    elif [ -x "$APP_PREFIX/bin/anwind-x11" ]; then
        ( export XDG_RUNTIME_DIR="$APP_PREFIX/tmp" TMPDIR="$APP_PREFIX/tmp"
          exec "$APP_PREFIX/bin/anwind-x11" ":$_num" >/dev/null 2>&1 ) &
        disown 2>/dev/null || true
    else
        info "警告: 内置 X 客户端缺失（$APP_PREFIX/bin/termux-x11）——打开一次 AnWind 主界面完成组件迁移后重试"
        return 1
    fi
    local _i=0
    while [ "$_i" -lt 20 ]; do
        [ -S "$_sock" ] && { info "X 服务就绪（socket X$_num，DISPLAY=:$_num）"; return 0; }
        sleep 0.5 2>/dev/null || sleep 1
        _i=$((_i + 1))
    done
    info "警告: X 服务拉起后 socket 未就绪（X$_num）——画面可能无法显示；排障: cat $_log 或 anwind-x11 doctor"
    return 1
}

# ---------- wine 二进制 ELF 架构识别（v2.1，多形态多版本核心） ----------
# 读 ELF 头 e_machine（偏移 18，2 字节小端）：
#   b7 00 = aarch64（bionic-arm64ec / wine-arm64 形态，原生直接跑）
#   3e 00 = x86_64（bionic-x86_64 / 普通Wine x86_64，经 box64/native）
detect_wine_arch() { # $1=wine 二进制 → 回显 aarch64|x86_64|unknown
    local _m
    [ -f "$1" ] || { echo unknown; return; }
    _m="$(dd if="$1" bs=1 skip=18 count=2 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')"
    case "$_m" in
        b700) echo aarch64 ;;
        3e00) echo x86_64 ;;
        *)    echo unknown ;;
    esac
}

# ---------- 音频自持（rootfs 自带 PulseAudio，unix socket 隔离） ----------
audio_setup() {
    local _audio
    _audio="$(conf_read "$CONT_CONF" audio "pulse")"
    case "$_audio" in
        off|none|disabled)
            # 整体关闭：清掉继承的 PULSE_SERVER，wine 走无声/disabled
            unset PULSE_SERVER
            export PULSE_SERVER=""
            return 0
            ;;
    esac

    local _pa_bin="$RFS_USR/bin/pulseaudio"
    local _pa_sock="$RFS_USR/tmp/pulse/native"

    if [ -x "$_pa_bin" ]; then
        # runtime 目录已在 isolate_env 指向 rootfs tmp
        mkdir -p "$RFS_USR/tmp/pulse" 2>/dev/null || true
        if [ ! -S "$_pa_sock" ]; then
            # 首次：拉起 rootfs 自带 pulse（sles-sink 直连 Android 音频，
            # unix socket 监听，与 Termux 侧 TCP 4713 互不相干）
            "$_pa_bin" --start --exit-idle-time=-1 \
                --disallow-exit=false >/dev/null 2>&1 || true
            # 等待默认 unix socket 就位（default.pa 自带
            # module-native-protocol-unix → $XDG_RUNTIME_DIR/pulse/native）
            local _n=0
            while [ "$_n" -lt 6 ]; do
                [ -S "$_pa_sock" ] && break
                sleep 0.5 2>/dev/null || sleep 1
                _n=$((_n + 1))
            done
        fi
        if [ -S "$_pa_sock" ]; then
            export PULSE_SERVER="unix:$_pa_sock"
            return 0
        fi
        # rootfs pulse 没起来 → 显式 TCP 兜底（仍是 rootfs 自己的实例）
        "$_pa_bin" --start --exit-idle-time=-1 \
            --load="module-native-protocol-tcp port=4713 auth-ip-acl=127.0.0.1 auth-anonymous=1" \
            >/dev/null 2>&1 || true
        if bash -c '(exec 3<>/dev/tcp/127.0.0.1/4713) 2>/dev/null'; then
            export PULSE_SERVER="127.0.0.1:4713"
            return 0
        fi
        info "警告: rootfs PulseAudio 未就绪（音频可能无声；anwind-container doctor 查看）"
        export PULSE_SERVER="unix:$_pa_sock"
        return 0
    fi

    # rootfs 未内置 pulseaudio（老 rootfs 包）→ 最后才借道 App 侧 TCP 4713
    export PULSE_SERVER="${PULSE_SERVER:-127.0.0.1:4713}"
}

# ---------- 后端探测 ----------
WINE_DIR="$RFS_USR/opt/wine"                 # 当前容器选择的 wine 目录
WINE_ARCH="unknown"                          # 槽位 wine 的 ELF 架构（v2.1）
WINE_HANGOVER="$RFS_USR/opt/bin/wine"        # aarch64 wine（旧版 hangover 兼容路径）
BOX64_BIN=""
FEX_BIN="$RFS_USR/opt/fex/bin/FEXInterpreter"
WINE_X86="$WINE_DIR/bin/wine"                # 槽位 wine 二进制（box64/fex/native/arm64ec 用）

for _c in "$RFS_USR/local/bin/box64" "$RFS_USR/bin/box64" "$APP_PREFIX/bin/box64"; do
    if [ -x "$_c" ]; then BOX64_BIN="$_c"; break; fi
done

backend_list() {
    echo "available backends:"
    # --list-backends 可能在容器/槽位解析前调用，此处兜底检测架构
    [ "$WINE_ARCH" = "unknown" ] && WINE_ARCH="$(detect_wine_arch "$WINE_X86")"
    if [ -x "$WINE_X86" ]; then
        case "$WINE_ARCH" in
            aarch64) echo "  [OK] arm64ec-wine: $WINE_X86（aarch64 原生，new WoW64）" ;;
            x86_64)  echo "  [OK] x86_64-wine : $WINE_X86" ;;
            *)       echo "  [OK] wine        : $WINE_X86（架构: $WINE_ARCH）" ;;
        esac
    else
        echo "  [--] 槽位 wine 未安装（anwind-container install-wine <类别|URL|包>）"
    fi
    [ -n "$BOX64_BIN" ] && echo "  [OK] box64       : $BOX64_BIN" || echo "  [--] box64 未安装"
    [ -x "$WINE_HANGOVER" ] && echo "  [OK] hangover    : $WINE_HANGOVER（旧版兼容路径）" || echo "  [--] hangover（旧版路径）未安装"
    [ -x "$FEX_BIN" ]   && echo "  [OK] fexcore     : $FEX_BIN"   || echo "  [--] fexcore 未安装（FEX-Emu 暂无 bionic 官方构建，安装后自动启用）"
}

# 依架构、槽位 wine 的 ELF 形态与可用组件推导 auto 后端：
#   aarch64 设备 + aarch64 wine → arm64ec（原生，无模拟开销）
#   aarch64 设备 + x86_64  wine → box64（有 box64 时）
#   兜底旧版 hangover 路径（/usr/opt/bin/wine）
auto_backend() {
    local _arch
    _arch="$(uname -m)"
    case "$_arch" in
        x86_64)
            [ -x "$WINE_X86" ] && { echo "native"; return; }
            ;;
        aarch64|arm64)
            if [ -x "$WINE_X86" ]; then
                case "$WINE_ARCH" in
                    aarch64) echo "arm64ec"; return ;;
                    x86_64)  [ -n "$BOX64_BIN" ] && { echo "box64"; return; } ;;
                esac
            fi
            if [ -x "$WINE_HANGOVER" ]; then
                echo "hangover"; return
            fi
            ;;
    esac
    echo ""
}

# ---------- 容器解析 ----------
resolve_container() {
    CONT_NAME="${ANWIND_CONTAINER:-}"
    if [ -n "${CONT_NAME:-}" ]; then return; fi
    CONT_NAME="$(conf_read "$CONF_GLOBAL" default_container "")"
    [ -n "$CONT_NAME" ] || die "未指定容器。用法: anwind-wine --container <name> <wine 参数...>，或先执行 anwind-container create"
}

load_container() {
    [ -n "${CONT_NAME:-}" ] || die "容器名为空"
    CONT_DIR="$CONT_ROOT/$CONT_NAME"
    [ -d "$CONT_DIR" ] || die "容器不存在: $CONT_NAME（anwind-container list 查看）"
    CONT_CONF="$CONT_DIR/container.conf"
    WINEPREFIX="$CONT_DIR/prefix"
    mkdir -p "$WINEPREFIX" "$LOG_DIR"
    export WINEPREFIX
}

# ---------- Wine 多版本解析 ----------
# 容器 wine= 目录名（/usr/opt/<名>）或绝对路径；空 → 全局 default_wine → /usr/opt/wine
resolve_wine_dir() {
    local _w
    _w="$(conf_read "$CONT_CONF" wine "")"
    if [ -n "$_w" ]; then
        case "$_w" in
            /*) WINE_DIR="$_w" ;;
            *)  WINE_DIR="$RFS_USR/opt/$_w" ;;
        esac
    else
        local _d
        _d="$(conf_read "$CONF_GLOBAL" default_wine "")"
        if [ -n "$_d" ]; then
            WINE_DIR="$RFS_USR/opt/$_d"
        else
            WINE_DIR="$RFS_USR/opt/wine"
        fi
    fi
    WINE_X86="$WINE_DIR/bin/wine"
    WINE_ARCH="$(detect_wine_arch "$WINE_X86")"
}

# ---------- 显示模式握手（对齐 glibc-runner -d/-v/-f） ----------
# 容器 conf: dmode=off|d|v|f + screen=native|WxH
# 握手文件:  $APP_PREFIX/tmp/.anwind-x11-res（App 侧 X11ResolutionLink 消费）
apply_display_mode() {
    local _dmode _screen
    _dmode="$(conf_read "$CONT_CONF" dmode "off")"
    _screen="$(conf_read "$CONT_CONF" screen "native")"

    case "$_dmode:$_screen" in
        d:*x*|v:*x*|f:*x*)
            # WxH 校验
            case "$_screen" in
                *[!0-9x]*|"") _screen="native" ;;
            esac
            if [ "$_screen" != "native" ]; then
                printf '%s\n' "$_screen" > "$APP_PREFIX/tmp/.anwind-x11-res" 2>/dev/null || true
                DMODE_RESOLUTION="$_screen"
                return 0
            fi
            ;;
    esac
    # off / native / 非法值：跟随窗口
    printf 'native\n' > "$APP_PREFIX/tmp/.anwind-x11-res" 2>/dev/null || true
    DMODE_RESOLUTION=""
}

# ---------- 显示模式虚拟化（v2.3 核心修复，wine >=10 环境必开） ----------
# 根因链（设备日志 CubeMap.exe 实证）：AnWind 的 X 服务（termux-x11/
# libXlorie）不支持 RandR 动态模式切换（分辨率由 .anwind-x11-res 握手
# 文件调整），而 wine 10+ 重构后的显示栈在 explorer 初始化显示设置时经
# x11drv 调 RandR 设模式 → NtUserChangeDisplaySettings 返回 -2
# （DISP_CHANGE_BADMODE）→ 模式表未写入注册表 → 游戏进程
# NtUserEnumDisplaySettings 连续报 "display mode not found" → DXUT/D3D
# 枚举不到任何显示模式 → D3D 设备创建失败弹错——所有游戏全挂。
# wine 上游为无 RandR 环境提供 EmulateModeset 开关（win32u/sysparams.c
# 读 HKCU\Software\Wine\X11 Driver\EmulateModeset）：开启后模式切换
# 在 win32u 内虚拟化成功（不触 X 驱动），枚举返回当前模式。
# 幂等写入；以 WINEPREFIX 下的标记文件避免每次启动重复起 wine reg。
ensure_emulate_modeset() {
    local _marker="$WINEPREFIX/.anwind-emulate-modeset"
    [ -f "$_marker" ] && return 0
    info "写入 EmulateModeset=Y（显示模式虚拟化——修复游戏枚举不到显示模式/设备创建失败）……"
    if wine_run reg add 'HKCU\Software\Wine\X11 Driver' /v EmulateModeset /t REG_SZ /d Y /f >/dev/null 2>&1; then
        touch "$_marker" 2>/dev/null || true
    else
        info "警告: EmulateModeset 写入失败（wine 未就绪？下次启动自动重试）"
    fi
}

# dmode=v 的注册表蓝底桌面清理（对齐 glibc-runner -f）
clear_wine_blue_desktop() {
    local _wine="$1"   # 已按后端包装的可执行调用函数名不适用——直接用 wine_run
    wine_run reg delete 'HKCU\Software\Wine\Explorer' /v Desktop /f >/dev/null 2>&1 || true
    wine_run reg delete 'HKCU\Software\Wine\Explorer\Desktops' /f >/dev/null 2>&1 || true
}

# ---------- Mesa / GPU 运行时（rootfs 自己的驱动栈） ----------
# v2.5：auto 默认 zink（GL-over-Vulkan）。根因链（设备日志 CubeMap.exe
# 实证）：本 X 服务（termux-x11/libXlorie）不提供 GLX/DRI3 → wine 10+
# 的 x11drv 落到 EGL 路径 → eglChooseConfig 需要能在 X11 平台上给出
# 窗口 config 的 gallium 驱动；freedreno 走 DRM/KGSL 直渲，无 DRI3 时
# EGL 拿不到任何 config（"egldrv_init_pixel_formats Failed to get any
# configs from eglChooseConfig" → wgl 全废 → exe 弹驱动错误）。而
# turnip 在同一会话已被 DXVK 实证可用（D3D9 设备/交换链创建成功），
# zink 复用同一条 Vulkan 通道出 GL。auto 判定：zink_dri.so + Vulkan
# ICD 都在 → zink；否则维持 freedreno（无回归）。x86_64 侧 rootfs
# mesa 只构建了 softpipe（无 llvmpipe），auto 同步纠正为 softpipe。
# 容器 conf gallium= 显式指定仍优先生效。
apply_gpu_env() {
    local _gallium _arch
    _arch="$(uname -m)"
    _gallium="$(conf_read "$CONT_CONF" gallium auto)"
    # Vulkan ICD（turnip）探测：auto 判定与 zink 显式指定共用
    GPU_VK_ICD="$(ls "$RFS_USR"/share/vulkan/icd.d/*.json \
                     "$RFS_USR"/etc/vulkan/icd.d/*.json 2>/dev/null | head -n 1)"
    if [ "$_gallium" = "auto" ]; then
        case "$_arch" in
            aarch64|arm64)
                if [ -n "$GPU_VK_ICD" ] && [ -e "$RFS_USR/lib/dri/zink_dri.so" ]; then
                    _gallium="zink"
                else
                    _gallium="freedreno"
                fi
                ;;
            *)             _gallium="softpipe" ;;
        esac
    fi
    case "$_gallium" in
        zink)
            # 对齐 glibc-runner 的 zink 全链配方（新旧 mesa 双变量兼容）
            export GALLIUM_DRIVER=zink
            export MESA_LOADER_DRIVER_OVERRIDE=zink
            export ZINK_DESCRIPTORS=lazy
            export ZINK_DEBUG=compact
            [ -d "$RFS_USR/lib/dri" ] && \
                export LIBGL_DRIVERS_PATH="${LIBGL_DRIVERS_PATH:-$RFS_USR/lib/dri}"
            # 显式锁定 ICD：与 DXVK 同一加载器同一路径，多 ICD 场景下
            # 锁定 turnip（仅在探测到时设置；探测不到时加载器默认搜索
            # 依然生效——DXVK 已实证默认搜索可用）
            if [ -n "$GPU_VK_ICD" ]; then
                export VK_DRIVER_FILES="$GPU_VK_ICD"
                export VK_ICD_FILENAMES="$GPU_VK_ICD"   # 旧加载器兼容
            fi
            ;;
        freedreno)
            export GALLIUM_DRIVER=freedreno
            ;;
        llvmpipe|softpipe)
            export GALLIUM_DRIVER="$_gallium"
            export LIBGL_ALWAYS_SOFTWARE=1
            ;;
    esac
    GPU_DRIVER="$_gallium"
}

# ---------- 用户附加环境 + DLL 覆盖 ----------
apply_extra_env() {
    local _extra
    _extra="$(conf_read "$CONT_CONF" env "")"
    if [ -n "$_extra" ]; then
        # shellcheck disable=SC2086
        export $_extra
    fi
    local _ovr
    _ovr="$(conf_read "$CONT_CONF" dxoverrides "")"
    [ -n "$_ovr" ] && export WINEDLLOVERRIDES="${_ovr}${WINEDLLOVERRIDES:+:$WINEDLLOVERRIDES}"
}

apply_box64_env() {
    local _preset
    _preset="$(conf_read "$CONT_CONF" preset performance)"
    export BOX64_LOG=0
    export BOX64_NOBANNER=1
    export BOX64_DYNAREC_TRACE=0
    # x86_64 glibc 运行库（rootfs 自带 usr/lib/x86_64-linux-gnu，由
    # bionic-rootfs 的 glibc-x86_64 配方安装）：本 wine 是 bionic 链接、
    # 不需要它；但容器内跑常规 glibc x86_64 Linux 程序时，box64 会在
    # BOX64_LD_LIBRARY_PATH 各目录里找 libc/ld-linux —— 缺它则直接报
    # "cannot open shared object file"。仅在目录存在时追加，不干扰纯
    # bionic 环境。
    if [ -d "$RFS_USR/lib/x86_64-linux-gnu" ]; then
        export BOX64_LD_LIBRARY_PATH="$RFS_USR/lib/x86_64-linux-gnu${BOX64_LD_LIBRARY_PATH:+:$BOX64_LD_LIBRARY_PATH}"
    fi
    case "$_preset" in
        compatibility)
            export BOX64_DYNAREC_BIGBLOCK=0
            export BOX64_DYNAREC_SAFEFLAGS=2
            export BOX64_DYNAREC_FASTNAN=0
            export BOX64_DYNAREC_FASTROUND=0
            export BOX64_DYNAREC_X87DOUBLE=1
            export BOX64_DYNAREC_STRONGMEM=1
            ;;
        performance|*)
            export BOX64_DYNAREC_BIGBLOCK=1
            export BOX64_DYNAREC_SAFEFLAGS=0
            export BOX64_DYNAREC_FASTNAN=1
            export BOX64_DYNAREC_FASTROUND=1
            export BOX64_DYNAREC_X87DOUBLE=0
            export BOX64_DYNAREC_STRONGMEM=0
            ;;
    esac
    # 容器 env 中允许覆盖 BOX64_*
    local _extra
    _extra="$(conf_read "$CONT_CONF" env "")"
    case "$_extra" in *BOX64_*) export $_extra ;; esac
}

# ---------- 后端执行 ----------
pick_backend() {
    BACKEND="$(conf_read "$CONT_CONF" backend auto)"
    if [ "$BACKEND" = "auto" ] || [ -z "$BACKEND" ]; then
        BACKEND="$(auto_backend)"
        [ -n "$BACKEND" ] || die "没有可用后端：既无 x86_64 wine + box64，也无 arm64ec/hangover wine。运行 'anwind-container doctor' 查看详情"
    fi
    case "$BACKEND" in
        box64)
            [ -n "$BOX64_BIN" ] || die "box64 未安装（anwind-container doctor）"
            [ -x "$WINE_X86" ]  || die "x86_64 wine 未安装：先执行 anwind-container install-wine（wine-catalog 可看在线构建）"
            [ "$WINE_ARCH" != "aarch64" ] || die "所选 wine 是 aarch64/arm64ec 形态，box64 后端不适用——backend 改 arm64ec 或 auto"
            ;;
        arm64ec)
            [ -x "$WINE_X86" ] || die "arm64ec wine 未安装：anwind-container install-wine bionic-arm64ec（wine-catalog 查看在线构建）"
            [ "$WINE_ARCH" = "aarch64" ] || die "所选 wine 不是 aarch64 形态（当前: ${WINE_ARCH:-unknown}）——arm64ec 后端需要 bionic-arm64ec 构建"
            ;;
        hangover)
            [ -x "$WINE_HANGOVER" ] || die "hangover wine 不在 $WINE_HANGOVER（aarch64 rootfs 构建时含 hangover-wine；新方案建议 install-wine bionic-arm64ec）"
            ;;
        fexcore)
            [ -x "$FEX_BIN" ]   && [ -e "$FEX_BIN" ] || die "FEXInterpreter 不在 $FEX_BIN。FEX-Emu 尚无官方 bionic 构建：可将自建 FEX 安装到 $RFS_USR/opt/fex/"
            [ -x "$WINE_X86" ] || die "x86_64 wine 未安装：先执行 anwind-container install-wine"
            ;;
        native)
            [ -x "$WINE_X86" ] || die "x86_64 wine 未安装"
            ;;
        *) die "未知后端: $BACKEND（可选 box64/hangover/fexcore/native/auto）" ;;
    esac
    # hangover 兜底路径不经 resolve_wine_dir 探测 —— 此处补上，会话日志
    # 的"wine形态"不再显示 unknown（排障需要知道架构形态）
    [ "$BACKEND" = "hangover" ] && WINE_ARCH="$(detect_wine_arch "$WINE_HANGOVER")"
    # 旧版内置 hangover 兜底提示：/usr/opt/bin/wine 是 rootfs 打包时的旧
    # 构建（早于 CI 的 gstreamer/esync/显示设置修复），仅作保底。槽位
    # wine（/usr/opt/<名>，install-wine 安装）缺失时才会走到这里。
    if [ "$BACKEND" = "hangover" ]; then
        info "提示: 当前使用 rootfs 内置 hangover wine（$WINE_HANGOVER）兜底路径 ——"
        info "      其 arm64ec 层为旧 llvm-mingw（20251202）工具链产物；hangover-11.16"
        info "      官方要求 20260826『fixed exit thunks』版，旧版 exit thunk 缺陷可致"
        info "      wineboot 二进制级崩溃（SEH invalid frame → kernel32 c0000135 → 53）。"
        info "      恢复主力路径（09-22 起设备实证可用的同款资产）:"
        info "      anwind-container install-wine bionic-x86_64 --default"
        info "      （bionic-arm64ec 槽位与内置同为旧工具链 arm64ec 形态，暂不建议）"
    fi
}

# wine_run：非 exec 的后端包装调用（供 reg 清理 / wineboot 用）
wine_run() {
    case "$BACKEND" in
        box64)    "$BOX64_BIN" "$WINE_X86" "$@" ;;
        native|arm64ec) "$WINE_X86" "$@" ;;
        hangover) "$WINE_HANGOVER" "$@" ;;
        fexcore)  "$FEX_BIN" "$WINE_X86" "$@" ;;
    esac
}

# ---------- 模拟器 DLL 预置（v2.10） ----------
# wine 源码实证（hangover-11.16 dlls/ntdll/loader.c load_arm64ec_module）：
# arm64ec 形态进程启动时按绝对路径 C:\windows\system32\libarm64ecfex.dll
# 加载 FES x64 模拟器（加载失败/初始化失败 → NtTerminateProcess 即刻
# 退出，c0000135 → 退出码 53）；find_dll_file 对绝对路径只查前缀文件、
# 无内置目录回退 —— 新建前缀 system32 为空时必然扑空。i386 侧的
# wowbox64.dll 同机制（HODLL32/wow64 cpu 链）。预置把 wine 安装目录
# （rootfs 组装时已从 hangover 官方 dlls.tar 装入 *-windows/）的
# lib*.dll + wow*.dll 幂等拷入前缀 system32 —— 与 hangover 官方安装
# 方式一致；aarch64/box64/native 后端不经此路径，零开销跳过。
seed_emulator_dlls() {
    case "$BACKEND" in hangover|arm64ec) ;; *) return 0 ;; esac
    local _winroot _dst _n=0 _f _b
    case "$BACKEND" in
        hangover) _winroot="$RFS_USR/opt/lib/wine" ;;
        arm64ec)  _winroot="$WINE_DIR/lib/wine" ;;
    esac
    _dst="$WINEPREFIX/drive_c/windows/system32"
    for _f in "$_winroot"/aarch64-windows/lib*.dll "$_winroot"/aarch64-windows/wow*.dll \
              "$_winroot"/arm64ec-windows/lib*.dll "$_winroot"/arm64ec-windows/wow*.dll; do
        [ -f "$_f" ] || continue
        _b="$(basename "$_f")"
        if [ ! -e "$_dst/$_b" ]; then
            mkdir -p "$_dst" 2>/dev/null || true
            cp -f -- "$_f" "$_dst/$_b" 2>/dev/null && _n=$((_n + 1))
        fi
    done
    if [ "$_n" -gt 0 ]; then
        info "模拟器 DLL 预置: $_n 个 → 前缀 system32（libarm64ecfex/wowbox64 等）"
        info "  —— arm64ec 进程按 C:\\windows\\system32 绝对路径加载它们，新前缀"
        info "     无此文件即 c0000135 鸡生蛋崩溃（wine loader 无内置回退）"
    elif [ ! -f "$_dst/libarm64ecfex.dll" ]; then
        info "提示: wine 安装目录无模拟器 DLL（$_winroot/*-windows/）——"
        info "      arm64ec 形态进程启动需要前缀 system32 里的 libarm64ecfex.dll。"
        info "      获取：重出 rootfs（make-rootfs 已自动装）或手动解 hangover"
        info "      官方 hangover_<ver>_dlls.tar 到 $_winroot/aarch64-windows/"
        info "      与 arm64ec-windows/（PE 文件与 bionic 无关，可直接复用）"
    fi
    return 0
}

# ---------- wineboot 执行前准备（v2.10：善后前移） ----------
# v2.6 的失败善后依赖子进程退出码；显式 wineboot 恢复 exec 后无法善后，
# 故等价动作前移到执行前：残缺前缀清理（无 system.reg 即从未初始化
# 成功，非用户数据，零风险）+ 模拟器 DLL 预置。幂等。
wineboot_preflight() {
    if [ -d "$WINEPREFIX" ] && [ ! -f "$WINEPREFIX/system.reg" ]; then
        if mv "$WINEPREFIX" "${WINEPREFIX}.stale.$$" 2>/dev/null; then
            rm -rf "${WINEPREFIX}.stale.$$" 2>/dev/null || true
        else
            rm -rf "$WINEPREFIX" 2>/dev/null || true
        fi
        mkdir -p "$WINEPREFIX" 2>/dev/null || true
        info "已清理残缺前缀（无 system.reg）—— 本次从零初始化，不在废墟上叠加"
    fi
    seed_emulator_dlls
    return 0
}

# ---------- ARM64X 混合探测（v2.11） ----------
# verify-arm64x.py 的纯 bash 移植（设备侧无 python 环境也能自检）：
# 读 PE32+ load config（数据目录第 10 项）里的 CHPEMetadataPointer ——
# 非 0 即 ARM64X 混合镜像（arm64ec 代码已并入，arm64ec 风味进程可加载）。
# 只读文件、不写任何状态；任何解析失败一律回报"无法解析"，绝不误判。
_pe_le() { # $1=文件 $2=偏移 $3=字节数 → stdout: 无符号小端整数（失败无输出）
    local _raw _v=0 _mul=1 _x
    _raw="$(dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null \
        | od -An -tu1 2>/dev/null | tr -s ' \n' ' ')"
    [ -n "${_raw// /}" ] || return 0
    for _x in $_raw; do
        _v=$((_v + _x * _mul))
        _mul=$((_mul * 256))
    done
    echo "$_v"
}

arm64x_probe() { # $1=PE32+ 文件 → stdout: 判读串（ARM64X…/纯 ARM64…/无法解析…）
    local _f="$1" _pe _mach _nsec _optsz _magic _lc _sec _s _va _vsz _rsz _rraw _off _cfgsz _chpe
    [ -f "$_f" ] || { echo "无法解析（文件不存在）"; return 0; }
    _pe="$(_pe_le "$_f" 60 4)"; [ -n "$_pe" ] || { echo "无法解析（坏 DOS 头）"; return 0; }
    _mach="$(_pe_le "$_f" $((_pe + 4)) 2)"
    _nsec="$(_pe_le "$_f" $((_pe + 6)) 2)"
    _optsz="$(_pe_le "$_f" $((_pe + 20)) 2)"
    _magic="$(_pe_le "$_f" $((_pe + 24)) 2)"
    case "${_magic:-}" in 523) ;; *) echo "无法解析（非 PE32+）"; return 0 ;; esac
    case "${_nsec:-}" in ''|*[!0-9]*) echo "无法解析（坏节数）"; return 0 ;; esac
    _lc="$(_pe_le "$_f" $((_pe + 216)) 4)"    # 数据目录[10] LOAD_CONFIG RVA
    if [ -z "$_lc" ] || [ "$_lc" -eq 0 ] 2>/dev/null; then
        echo "纯 ARM64（无 load config 目录 —— 无 CHPE 元数据）"; return 0
    fi
    _sec=$((_pe + 24 + _optsz))
    _s=0; _off=""
    while [ "$_s" -lt "$_nsec" ]; do
        _va="$(_pe_le "$_f" $((_sec + _s * 40 + 12)) 4)"
        _vsz="$(_pe_le "$_f" $((_sec + _s * 40 + 8)) 4)"
        _rsz="$(_pe_le "$_f" $((_sec + _s * 40 + 16)) 4)"
        _rraw="$(_pe_le "$_f" $((_sec + _s * 40 + 20)) 4)"
        if [ -n "$_va" ] && [ -n "$_vsz" ] && [ -n "$_rsz" ] && [ -n "$_rraw" ] \
           && [ "$_lc" -ge "$_va" ] \
           && [ "$_lc" -lt $((_va + (_vsz > _rsz ? _vsz : _rsz))) ]; then
            _off=$((_rraw + _lc - _va)); break
        fi
        _s=$((_s + 1))
    done
    [ -n "$_off" ] || { echo "无法解析（load config 未映射到节）"; return 0; }
    _cfgsz="$(_pe_le "$_f" "$_off" 4)"
    if [ -z "$_cfgsz" ]; then
        echo "无法解析（load config 数据不可读 —— 文件截断？）"; return 0
    fi
    if [ "$_cfgsz" -lt 208 ] 2>/dev/null; then
        echo "纯 ARM64（load config 无 CHPE 字段）"; return 0
    fi
    _chpe="$(_pe_le "$_f" $((_off + 200)) 8)"  # PE32+ CHPEMetadataPointer @ +0xC8
    if [ -z "$_chpe" ]; then
        echo "无法解析（CHPE 字段不可读 —— 文件截断？）"; return 0
    fi
    if [ "$_chpe" -gt 0 ] 2>/dev/null; then
        echo "ARM64X 混合（machine=0x$(printf '%04x' "${_mach:-0}")，CHPE=0x$(printf '%x' "$_chpe")）"
    else
        echo "纯 ARM64（machine=0x$(printf '%04x' "${_mach:-0}")，CHPE=0 —— arm64ec 进程不可加载）"
    fi
    return 0
}

# ---------- 架构风味清单（v2.11：ARM64X 判读修正） ----------
# "could not load kernel32.dll, c0000135" 的直接成因之一：kernel32.dll 对
# 当前进程风味不可加载。判据说明（v2.11 修正）：ARM64X 设计下 arm64ec
# 风味代码并入 aarch64-windows/ 混合 PE —— 检查"独立 arm64ec-windows/
# 目录在位"是误设（本构建形态不产出它）；真正的硬判据是
# aarch64-windows/kernel32.dll 的 CHPE 元数据（arm64x_probe 现场探测）。
wineboot_flavor_inventory() {
    local _winroot _d _k32 _verdict
    case "$BACKEND" in
        hangover) _winroot="$RFS_USR/opt/lib/wine" ;;
        *)        _winroot="$WINE_DIR/lib/wine" ;;
    esac
    echo "[inventory] wine 安装目录: $_winroot"
    _k32="$_winroot/aarch64-windows/kernel32.dll"
    if [ -f "$_k32" ]; then
        _verdict="$(arm64x_probe "$_k32")"
        echo "[inventory]   aarch64-windows/kernel32.dll: 在位（$_verdict）"
        case "$_verdict" in
            ARM64X*)
                echo "[inventory]     —— ARM64X 合格：arm64ec 风味进程可加载。若 wineboot"
                echo "[inventory]       仍崩，则指向 arm64ec 过渡代码（exit thunk）运行时缺陷"
                echo "[inventory]       （旧 llvm-mingw 工具链已知风险）—— 二进制层，换 wine 即愈" ;;
            纯*)
                echo "[inventory]     —— 非 ARM64X：arm64ec 风味进程无法加载 kernel32 →"
                echo "[inventory]       wineboot c0000135 / 退出码 53 二进制层实锤"
                echo "[inventory]       （arm64ec 混合构建失败，旧 llvm-mingw 工具链产物）" ;;
            *) : ;;
        esac
    else
        echo "[inventory]   aarch64-windows/kernel32.dll: 缺失（核心文件不在位）"
    fi
    if [ -f "$_winroot/i386-windows/kernel32.dll" ]; then
        echo "[inventory]   i386-windows/kernel32.dll: 在位"
    else
        echo "[inventory]   i386-windows/kernel32.dll: 缺失"
    fi
    echo "[inventory]   （arm64ec 风味代码按 ARM64X 设计并入 aarch64-windows/；"
    echo "[inventory]     独立 arm64ec-windows/ 目录本构建形态不产出，其缺失属正常）"
    for _d in aarch64-windows arm64ec-windows; do
        [ -f "$_winroot/$_d/libarm64ecfex.dll" ] && echo "[inventory]   $_d/libarm64ecfex.dll: 在位"
        [ -f "$_winroot/$_d/wowbox64.dll" ] && echo "[inventory]   $_d/wowbox64.dll: 在位"
    done
    echo "[inventory] 前缀 system32: $WINEPREFIX/drive_c/windows/system32"
    ls -1 "$WINEPREFIX/drive_c/windows/system32" 2>/dev/null | sed 's/^/[inventory]   /' | head -n 8
    return 0
}

# ---------- wineboot 失败善后（v2.6） ----------
# 设备日志（wine-1111-*.log）实证：wineboot 中途崩溃（seh invalid
# frame 级联 → "could not load kernel32.dll"）会留下残缺前缀；原样
# 重试会在废墟上叠加，前缀永久损坏。善后三步：
#   1) system.reg 未生成（初始化从未成功过）→ 清空 prefix —— 此时
#      不含任何用户数据，删除零风险；一旦 system.reg 存在（前缀曾
#      初始化成功）则绝不自动删除；
#   2) wineserver -k 收尸，避免残留服务进程锁住注册表/socket；
#   3) 终端与日志同步给出行动指引（换 wine 的具体命令 + 基线对照
#      法 + 日志文件路径）。
wineboot_failed_action() { # $1 = wineboot 退出码
    local _rc="${1:-?}"
    info "wineboot 失败（退出码 $_rc）——前缀初始化未完成。"
    if [ -d "$WINEPREFIX" ] && [ ! -f "$WINEPREFIX/system.reg" ]; then
        # 先改名再删：大目录删除中途被打断也不会留下"半删"状态
        if mv "$WINEPREFIX" "${WINEPREFIX}.stale.$$" 2>/dev/null; then
            rm -rf "${WINEPREFIX}.stale.$$" 2>/dev/null || true
        else
            rm -rf "$WINEPREFIX" 2>/dev/null || true
        fi
        mkdir -p "$WINEPREFIX" 2>/dev/null || true
        info "已清理残缺前缀（$WINEPREFIX）——下次初始化从零开始，不在废墟上叠加。"
    fi
    case "$BACKEND" in
        box64)          "$BOX64_BIN" "$(dirname "$WINE_X86")/wineserver" -k >/dev/null 2>&1 || true ;;
        native|arm64ec) "$(dirname "$WINE_X86")/wineserver" -k >/dev/null 2>&1 || true ;;
        hangover)       "$(dirname "$WINE_HANGOVER")/wineserver" -k >/dev/null 2>&1 || true ;;
        fexcore)        "$FEX_BIN" "$(dirname "$WINE_X86")/wineserver" -k >/dev/null 2>&1 || true ;;
    esac
    info "排查建议（按序执行，命令可直接复制）:"
    info "  1. 恢复主力路径 —— 绕开内置 wine 的 arm64ec 二进制层（首选）:"
    info "     anwind-container install-wine bionic-x86_64 --default"
    info "     anwind-wine --container <容器名> wineboot -i"
    info "     —— 预期会话头『后端=box64』、退出码 0、前缀生成 system.reg"
    info "  2. 若 box64 形态仍崩（box64 0.4.4 回归疑点）:"
    info "     anwind-container install-box64   # 或指定 Releases 的 v0.4.2 资产"
    info "  3. 60 秒基线裁决（v2.3 语义复刻 + ARM64X 探测）:"
    info "     anwind-wine --wineboot-baseline <容器名>"
    info "     —— 清单里 CHPE 探测直接给出二进制层定性"
    info "  4. 本会话决策日志: ${ANWIND_LOG_FILE:-（未落盘）}"
}

run_wine() {
    # wineserver 是独立 Unix 程序，需直接执行其宿主二进制
    if [ "${1:-}" = "wineserver" ]; then
        local _bin
        case "$BACKEND" in
            box64|native|fexcore|arm64ec) _bin="$(dirname "$WINE_X86")/wineserver" ;;
            hangover)                     _bin="$(dirname "$WINE_HANGOVER")/wineserver" ;;
        esac
        shift
        case "$BACKEND" in
            box64)    exec "$BOX64_BIN" "$_bin" "$@" ;;
            native|arm64ec) exec "$_bin" "$@" ;;
            hangover) exec "$_bin" "$@" ;;
            fexcore)  exec "$FEX_BIN" "$_bin" "$@" ;;
        esac
    fi
    # wineboot：v2.10 恢复 v2.3 的 exec 直跑（进程替换）。
    # 取证结论（598e60e 对照）：v2.4 对 wineboot 仍 exec、仅把 stdio 接
    # 进 tee 管道即触发崩溃；v2.6 的子进程化本身与崩溃无因果（v2.3 的
    # 首次自动初始化从来就是子进程执行且工作正常）。exec 恢复后，v2.6
    # 的失败善后（残缺前缀清理）等价前移到 wineboot_preflight 执行前。
    if [ "${1:-}" = "wineboot" ]; then
        shift   # 去掉 wineboot 自身，$@ = -i/-u/... 原样转交
        wineboot_preflight
        case "$BACKEND" in
            box64)          exec "$BOX64_BIN" "$(dirname "$WINE_X86")/wineboot" "$@" ;;
            native|arm64ec) exec "$(dirname "$WINE_X86")/wineboot" "$@" ;;
            hangover)       exec "$(dirname "$WINE_HANGOVER")/wineboot" "$@" ;;
            fexcore)        exec "$FEX_BIN" "$(dirname "$WINE_X86")/wineboot" "$@" ;;
        esac
    fi
    # 首次运行自动初始化前缀（wineboot -i）—— 子进程执行 + 退出码善后
    # （v2.3 起即如此，保留；v2.10 增加执行前 preflight：清残缺 + 预置）
    if [ ! -f "$WINEPREFIX/system.reg" ]; then
        info "首次使用，初始化 wine 前缀: $WINEPREFIX"
        wineboot_preflight
        local _irc=0
        case "$BACKEND" in
            box64)          "$BOX64_BIN" "$(dirname "$WINE_X86")/wineboot" -i ;;
            native|arm64ec) "$(dirname "$WINE_X86")/wineboot" -i ;;
            hangover)       "$(dirname "$WINE_HANGOVER")/wineboot" -i ;;
            fexcore)        "$FEX_BIN" "$(dirname "$WINE_X86")/wineboot" -i ;;
        esac
        _irc=$?
        echo
        if [ "$_irc" -ne 0 ]; then
            # 前缀未就绪，后续 exe 必然跟着报一堆无关错误 —— 止损退出
            wineboot_failed_action "$_irc"
            exit "$_irc"
        fi
    fi
    # 显示模式虚拟化（幂等；必须先于一切 wine 子命令——explorer 初始化
    # 显示设置时就需要它，否则模式表写不进注册表，游戏全部报错）
    ensure_emulate_modeset
    # dmode=f：启动前清除注册表 wine 蓝底桌面（强制窗口直出）
    if [ "$DMODE" = "f" ] && [ -n "$DMODE_RESOLUTION" ]; then
        clear_wine_blue_desktop
    fi
    # dmode=v：wine 虚拟桌面（explorer /desktop）
    if [ "$DMODE" = "v" ] && [ -n "$DMODE_RESOLUTION" ]; then
        case "$BACKEND" in
            box64)    exec "$BOX64_BIN" "$WINE_X86" explorer "/desktop=AnWind,$DMODE_RESOLUTION" "$@" ;;
            native|arm64ec) exec "$WINE_X86" explorer "/desktop=AnWind,$DMODE_RESOLUTION" "$@" ;;
            hangover) exec "$WINE_HANGOVER" explorer "/desktop=AnWind,$DMODE_RESOLUTION" "$@" ;;
            fexcore)  exec "$FEX_BIN" "$WINE_X86" explorer "/desktop=AnWind,$DMODE_RESOLUTION" "$@" ;;
        esac
    fi
    case "$BACKEND" in
        box64)    exec "$BOX64_BIN" "$WINE_X86" "$@" ;;
        native|arm64ec) exec "$WINE_X86" "$@" ;;
        hangover) exec "$WINE_HANGOVER" "$@" ;;
        fexcore)  exec "$FEX_BIN" "$WINE_X86" "$@" ;;
    esac
}

# ---------- 主入口 ----------
CMD="${1:-}"
[ -n "$CMD" ] || { version; echo; usage; exit 0; }

case "$CMD" in
    help|--help|-h)
        usage
        exit 0
        ;;
    --container)
        shift
        [ -n "${1:-}" ] || die "--container 需要容器名"
        export ANWIND_CONTAINER="$1"
        shift
        ;;
    --list-backends|--backends)
        backend_list
        exit 0
        ;;
    --wineboot-baseline)
        # v2.10：60 秒裁决基线 —— v2.3 语义复刻（无会话日志/无探测/
        # 无 SONAME 自愈/无任何管道；GL env 按 v2.3 无差别应用），
        # 打印架构风味清单后 exec wineboot -i。
        shift
        [ -n "${1:-}" ] && { export ANWIND_CONTAINER="$1"; shift; }
        export ANWIND_BASELINE=1
        ;;
    --debug)
        # 诊断模式：seh（崩溃/异常）、模块加载、vulkan/wgl 错误全开，
        # 排障时把输出整体发回即可定位（用法: anwind-wine --debug <exe路径>）
        shift
        [ -n "${1:-}" ] || die "--debug 需要跟 wine 参数（例如: anwind-wine --debug <exe路径>）"
        export WINEDEBUG="${WINEDEBUG:-+seh,+module,err+vulkan,err+wgl}"
        ;;
    --version|-V)
        version
        exit 0
        ;;
esac

resolve_container
if [ "${ANWIND_BASELINE:-0}" != "1" ]; then
    # v2.4 会话日志：先于一切决策初始化（v2.9：attach 已永久降级为
    # NO_TEE —— 决策行经 info() 落盘，wine 输出保持 pty 原生直连）
    session_log_init
    session_log_attach
    # v2.7 SONAME 自愈：必须在任何 wine 调用前（wine 的 unix .so 按版本
    # SONAME 解析）；旧 rootfs（20261025 前）不打别名 → winex11 等模块
    # 加载不出来 → 各种"神秘"崩溃。幂等，新 rootfs 零开销跳过。
    fix_soname_aliases
fi
load_container
resolve_wine_dir
DMODE="$(conf_read "$CONT_CONF" dmode "off")"
DMODE_RESOLUTION=""

# 顺序关键：隔离 → 显示握手 → 音频 → GPU（按命令类型）→ 附加环境 → X 服务自启 → 后端
isolate_env
apply_display_mode
audio_setup
# v2.6：GL 环境只作用于真正的图形会话。维护类子命令（wineboot/
# wineserver/reg* 等）全程用不到图形驱动栈 —— 前缀初始化会话携带
# zink/EGL 变量只会引入无关变量（设备日志 wine-1111 实证：v2.5 的
# zink 默认值恰在 wineboot 会话生效）。ANWIND_SAFE=1 时整体旁路
# （基线对照模式，排障用）。
MAINT_LIST=" wineboot wineserver reg regedit regsvr32 msiexec services plugplay rundll32 winemenubuilder "
case "$MAINT_LIST" in
    *" ${1:-} "*) IS_MAINT=1 ;;
    *)            IS_MAINT=0 ;;
esac
GPU_APPLIED=0
if [ "${ANWIND_BASELINE:-0}" = "1" ]; then
    apply_gpu_env        # v2.3 复刻：GL env 无差别应用（含 wineboot）
    GPU_APPLIED=1
elif [ "${ANWIND_SAFE:-0}" != "1" ] && [ "$IS_MAINT" = "0" ]; then
    apply_gpu_env
    GPU_APPLIED=1
fi
apply_extra_env
ensure_x11
pick_backend
case "$BACKEND" in box64|fexcore) apply_box64_env ;; esac

# v2.10 基线裁决模式的最终执行点：v2.3 语义直跑 wineboot -i。
# 此后不再有任何 v2.4+ 附加动作（探测/自愈/日志一概不经过）。
if [ "${ANWIND_BASELINE:-0}" = "1" ]; then
    if [ -d "$WINEPREFIX" ] && [ ! -f "$WINEPREFIX/system.reg" ]; then
        rm -rf "$WINEPREFIX" 2>/dev/null || true
        mkdir -p "$WINEPREFIX" 2>/dev/null || true
        echo "[baseline] 已清理残缺前缀（等价新容器首跑状态）"
    fi
    wineboot_flavor_inventory
    echo "[baseline] 容器=$CONT_NAME 后端=$BACKEND wine形态=${WINE_ARCH:-?} WINEPREFIX=$WINEPREFIX"
    echo "[baseline] exec wineboot -i（v2.3 原样：无日志/无自愈/无管道）"
    case "$BACKEND" in
        box64)          exec "$BOX64_BIN" "$(dirname "$WINE_X86")/wineboot" -i ;;
        native|arm64ec) exec "$(dirname "$WINE_X86")/wineboot" -i ;;
        hangover)       exec "$(dirname "$WINE_HANGOVER")/wineboot" -i ;;
        fexcore)        exec "$FEX_BIN" "$(dirname "$WINE_X86")/wineboot" -i ;;
    esac
fi

info "会话开始 $(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo '?') 内核=$(uname -m 2>/dev/null) pid=$$"
info "会话日志: ${ANWIND_LOG_FILE:-（无可写目录，未落盘——检查存储权限）}"
# v2.7 可观测性：rootfs 构建戳（新 rootfs 有；旧 rootfs 缺失即提示日期特征）
ROOTFS_BUILD_ID="$(conf_read "$RFS_USR/etc/anwind/rootfs-build-id" build "")"
if [ -n "$ROOTFS_BUILD_ID" ]; then
    info "rootfs 构建戳: $ROOTFS_BUILD_ID"
else
    info "rootfs 构建戳: 无（20261025 前旧 rootfs——SONAME 别名已运行时自愈）"
fi
info "容器=$CONT_NAME 后端=$BACKEND wine形态=${WINE_ARCH:-?} DISPLAY=$DISPLAY WINEPREFIX=$WINEPREFIX"
# v2.7：box64 版本进日志（排障三要素：rootfs 戳 + box64 版本 + wine 形态）
# v2.8：探测失败也留痕（区分"没装 box64"与"装了但版本探测失败"）
BOX64_VER=""
if [ -n "$BOX64_BIN" ]; then
    BOX64_VER="$(box64_version "$BOX64_BIN")"
    if [ -n "$BOX64_VER" ]; then
        info "box64: $BOX64_BIN（v$BOX64_VER）"
    else
        info "box64: $BOX64_BIN（版本未知——--version 探测失败，排障可手跑: $BOX64_BIN --version）"
    fi
fi
# hangover 兜底后端的版本错配告警：hangover-11.16 官方配套 box64 v0.4.4
# （AndreRH/hangover releases 实证）；错配可致 SEH invalid frame 级联
# （box64 #2365 同款签名）。arm64ec 模拟器 DLL（wowbox64/libarm64ecfex）
# 为 hangover 后端跑 x86/x64 程序的必需件，一并探测。
if [ "$BACKEND" = "hangover" ]; then
    HO_TAG="$(conf_read "$RFS_USR/opt/.anwind-wine-info" tag "")"
    [ -n "$HO_TAG" ] && info "hangover 运行时: $HO_TAG"
    # v2.8：bionic 堆打标修复内置探测（根治 wineboot SEH 级联 / 退出码 53 的
    # 修复落在 ntdll.so —— 字符串标记 "bionic heap tagging disabled" 只存在于
    # 打过 0006 补丁的构建）。设备日志从此可直接回答"这个 wine 有没有修复"。
    HO_TAGFIX="unknown"
    for _so in "$RFS_USR/opt/lib/wine/aarch64-unix/ntdll.so" \
               "$RFS_USR/opt/lib/wine/x86_64-unix/ntdll.so"; do
        if [ -f "$_so" ]; then
            if grep -aq "bionic heap tagging disabled" "$_so" 2>/dev/null; then
                HO_TAGFIX="yes"
            else
                HO_TAGFIX="no"
            fi
            break
        fi
    done
    case "$HO_TAGFIX" in
        yes) info "wine 堆打标修复: 已内置（0006 补丁 —— bionic TBI 0xB4 崩溃已根治）" ;;
        no)  info "wine 堆打标修复: 缺失！当前 wine 构建于修复之前 —— wineboot SEH 级联崩溃"
             info "      （invalid frame → not in stack limits → kernel32 c0000135 → 退出码 53）"
             info "      会复发。需用含 0006-fix-bionic-heap-tagging.patch 的配方重出 rootfs。" ;;
        *)   info "wine 堆打标修复: 未能定位 ntdll.so（$RFS_USR/opt/lib/wine/*-unix/）—— 无法探测" ;;
    esac
    if [ -n "$BOX64_VER" ] && ver_lt "$BOX64_VER" "0.4.4"; then
        info "警告: box64 v$BOX64_VER 低于 hangover-11.16 官方配套 v0.4.4 ——"
        info "       hangover↔box64 协议版本敏感，SEH 崩溃风险。升级命令:"
        info "       anwind-container install-box64"
    fi
    if [ -z "$(find "$RFS_USR/opt/lib/wine" "$WINE_DIR/lib/wine" "$WINEPREFIX/drive_c/windows" \
                 -name wowbox64.dll -o -name libarm64ecfex.dll 2>/dev/null | head -n 1)" ]; then
        info "提示: 未探测到模拟器 DLL（wowbox64/libarm64ecfex）——arm64ec 形态"
        info "      进程按前缀绝对路径加载它们（C:\\windows\\system32，wine loader"
        info "      无内置回退）；v2.10 已自动预置进前缀，但安装目录本身缺源时"
        info "      x86/x64 能力仍不可用。获取：重出 rootfs（make-rootfs 自动装）"
        info "      或手动解 hangover 官方 hangover_<ver>_dlls.tar 到"
        info "      $RFS_USR/opt/lib/wine/{aarch64,arm64ec}-windows/（PE 文件与"
        info "      bionic 无关，可直接复用）"
    fi
fi
[ -n "$DMODE_RESOLUTION" ] && info "显示模式 dmode=$DMODE 分辨率=$DMODE_RESOLUTION（X11 握手已写入）"
info "环境: PREFIX=$PREFIX HOME=$HOME LANG=$LANG 音频=${PULSE_SERVER:-（关）}"
if [ "$GPU_APPLIED" = "1" ]; then
    if [ -n "$GPU_VK_ICD" ]; then
        info "GPU: GL驱动=${GPU_DRIVER:-auto}（GALLIUM_DRIVER=${GALLIUM_DRIVER:-未设}）Vulkan ICD=$(basename "$GPU_VK_ICD")"
    else
        info "GPU: GL驱动=${GPU_DRIVER:-auto}（GALLIUM_DRIVER=${GALLIUM_DRIVER:-未设}）Vulkan ICD=无"
    fi
elif [ "${ANWIND_SAFE:-0}" = "1" ]; then
    info "GPU: GL 环境已旁路（ANWIND_SAFE=1 基线对照模式）"
else
    info "GPU: GL 环境未应用（维护命令 ${1:-}——前缀初始化无需图形栈）"
fi
info "wine 目录: $WINE_DIR  参数: $*"
run_wine "$@"
