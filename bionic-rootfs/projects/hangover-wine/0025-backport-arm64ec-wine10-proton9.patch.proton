# anwind backport 注：wine-10 在此删除了 _load_config_used asm 块（挪进
# winebuild spec32.c output_load_config 按模块产出）；本回移不包含 wine-
# build 的该提交（p9 spec32.c 无 output_load_config），删块会让所有 EC 模
# 块链接失败（lld-link: EC version of '_load_config_used' is missing）——
# 保留 wine-9 的 CRT 内联块（见文件头【修法】5 的例外说明）。

--- a/dlls/wow64/process.c	2025-01-20 21:30:19.000000000 +0000
+++ b/dlls/wow64/process.c	2026-11-14 00:00:00.000000000 +0000
@@ -1027,12 +1027,21 @@
 /**********************************************************************
  *           wow64_NtSuspendThread
  */
+/* anwind backport (0011): declared locally - ntdll.spec exports this from
+ * ntdll (signal_arm64.c on aarch64, signal_arm64ec.c EC stub) and no public
+ * header declares it in this tree. */
+extern NTSTATUS WINAPI RtlWow64SuspendThread( HANDLE thread, ULONG *count );
+
 NTSTATUS WINAPI wow64_NtSuspendThread( UINT *args )
 {
     HANDLE handle = get_handle( &args );
     ULONG *count = get_ptr( &args );
 
+#if defined(__aarch64__) || defined(__arm64ec__) /* anwind: suspend pipeline (FEX/HODLL64) - aarch64+EC passes */
+    return RtlWow64SuspendThread( handle, count );
+#else /* anwind: wine-10 form - the x86_64 host pass has no RtlWow64SuspendThread */
     return NtSuspendThread( handle, count );
+#endif
 }
 
 

--- a/dlls/wow64/syscall.c	2025-01-20 21:30:19.000000000 +0000
+++ b/dlls/wow64/syscall.c	2026-11-13 09:11:54.821471526 +0000
@@ -99,6 +99,7 @@
 static BOOLEAN  (WINAPI *pBTCpuIsProcessorFeaturePresent)(UINT);
 static void     (WINAPI *pBTCpuProcessInit)(void);
 static NTSTATUS (WINAPI *pBTCpuSetContext)(HANDLE,HANDLE,void *,void *);
+static NTSTATUS (WINAPI *pBTCpuSuspendLocalThread)(HANDLE,ULONG *); /* anwind backport (0011) */
 static void     (WINAPI *pBTCpuThreadInit)(void);
 static void     (WINAPI *pBTCpuSimulate)(void);
 static void *   (WINAPI *p__wine_get_unix_opcode)(void);
@@ -798,6 +799,7 @@
     GET_PTR( BTCpuProcessInit );
     GET_PTR( BTCpuThreadInit );
     GET_PTR( BTCpuResetToConsistentState );
+    GET_PTR( BTCpuSuspendLocalThread ); /* anwind backport (0011) */
     GET_PTR( BTCpuSetContext );
     GET_PTR( BTCpuSimulate );
     GET_PTR( BTCpuNotifyFlushInstructionCache2 );
@@ -1411,3 +1413,11 @@
     __ENDTRY
     return STATUS_SUCCESS;
 }
+
+/**********************************************************************
+ *            Wow64SuspendLocalThread (wow64.@)  (anwind backport, 0011)
+ */
+NTSTATUS WINAPI Wow64SuspendLocalThread( HANDLE thread, ULONG *count )
+{
+    return pBTCpuSuspendLocalThread( thread, count );
+}

