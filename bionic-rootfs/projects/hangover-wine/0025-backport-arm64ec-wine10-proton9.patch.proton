+/* anwind backport: proton_9.0-specific ntdll syscalls (ntdll.spec -syscall entries
+ * that make_specfiles folds into the generated ntsyscalls.h; vanilla wine-10 trees
+ * do not have them).  Without these the arm64ec_syscalls table references
+ * "#__wine_*$hp_target" symbols that nothing defines -> EC link failure. */
+/* anwind backport: proton_9.0 专属 -syscall 导出的 EC 裸跳板（0020 的
+ * CI 实证形态 —— DEFINE_SYSCALL 宏形态与 debug.h 的 WINAPI 原型相冲，
+ * 返回类型/参数与 debug.h / winternl.h 声明逐字一致）。 */
+unsigned int SYSCALL_API __wine_dbg_ftrace( char *str, unsigned int str_size, unsigned int ctx )
+{
+    __ASM_SYSCALL_FUNC( __id___wine_dbg_ftrace, __wine_dbg_ftrace );
 }
 
