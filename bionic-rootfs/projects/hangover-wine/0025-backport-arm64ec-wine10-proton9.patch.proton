-/*******************************************************************
- *		RtlUnwind (NTDLL.@)
+/*************************************************************************
+ *		RtlGetNativeSystemInformation (NTDLL.@)
  */
-void WINAPI RtlUnwind( void *frame, void *target_ip, EXCEPTION_RECORD *rec, void *retval )
+NTSTATUS WINAPI RtlGetNativeSystemInformation( SYSTEM_INFORMATION_CLASS class,
