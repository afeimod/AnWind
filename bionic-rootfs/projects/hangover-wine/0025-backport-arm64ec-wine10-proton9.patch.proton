      "\t.rva __hybrid_auxiliary_iat_copy\n"
-     "\t.rva __os_arm64x_helper0\n"
-     "\t.rva __os_arm64x_helper1\n"
-     "\t.rva __os_arm64x_helper2\n"
+     "\t.rva __hybrid_auxiliary_delayload_iat\n"
