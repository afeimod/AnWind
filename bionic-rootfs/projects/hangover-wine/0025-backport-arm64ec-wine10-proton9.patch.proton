-                                    TOKEN_OWNER *owner, TOKEN_PRIMARY_GROUP *group,
-                                    TOKEN_DEFAULT_DACL *dacl, TOKEN_SOURCE *source )
+NTSTATUS SYSCALL_API __wine_set_unix_env( const char *var, const char *val )
 {
-    __ASM_SYSCALL_FUNC( __id_NtCreateToken );
+    __ASM_SYSCALL_FUNC( __id___wine_set_unix_env, __wine_set_unix_env );
 }
 
