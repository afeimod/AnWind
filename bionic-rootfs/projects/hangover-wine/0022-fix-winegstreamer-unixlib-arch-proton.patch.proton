# anwind: proton_9.0 arm64ec 第五批炸点 —— winegstreamer unixlib.c 的
# GStreamer registry 架构判定不含 aarch64（#error Bad arch）（v3.3.41）
#
# 【根因】（CI wine-build-log-arm64ec (8).zip 实证链条终点）：
#   前四批炸点（0007/0015/0016/0019/0020）修完后，主 make 推进至
#   dlls/winegstreamer/unixlib.o 阵亡：
#     dlls/winegstreamer/unixlib.c:285:2: error: Bad arch
#     dlls/winegstreamer/unixlib.c:288:25: error: use of undeclared identifier 'arch'
#     2 errors generated.
#     make: *** [Makefile:205664: dlls/winegstreamer/unixlib.o] Error 1
#
# 【机制】
#   unixlib.c 头部的 GStreamer registry 路径选择块只有 x86 两个分支：
#     #if defined(__x86_64__)
#             const char *arch = "/registry.x86_64.bin";
#     #elif defined(__i386__)
#             const char *arch = "/registry.i386.bin";
#     #else
#     #error Bad arch
#     #endif
#   该文件带 `#pragma makedep unix` 标记 → 属 unix 侧库（UNIXLIB =
#   winegstreamer.so），由 **host 编译器**（arm64ec 形态 = unix aarch64
#   + PE arm64ec/aarch64/i386，即 aarch64-linux-android28-clang）编译。
#   aarch64 编译器既不定义 __x86_64__ 也不定义 __i386__ → 直落 #else →
#   #error Bad arch；#else 分支里 `arch` 变量根本没声明 → 连带报
#   "use of undeclared identifier 'arch'"（第 288 行 strcat(gst_reg, arch)）。
#
#   为什么 x86_64 形态没事：unix 侧 = x86_64 → __x86_64__ 命中首分支。
#   为什么 proton_10.0+ 没事：Valve 已在 proton_10.0 树把 aarch64 分支
#   补上（见本补丁末尾"上游对照"），recipe 的门控天然跳过。
#
# 【为什么这个架构名是对的】
#   GST_REGISTRY_1_0 指向的是 **unix 侧** gstreamer 的 registry 缓存文件名，
#   其后缀由 unix 侧 gstreamer 自身的 arch 决定（gst_registry_get_default()
#   → "<registry>.aarch64.bin"）。arm64ec 形态的 unix 侧是 aarch64 → 必须用
#   /registry.aarch64.bin；PE 侧目标架构（arm64ec/aarch64/i386）与此无关。
#
# 【修法】按 proton_10.0 上游同款形态补 aarch64 分支（逐字回移 Valve 的
#   改动，x86/x86_64 路径逐字节不变，仅新增 aarch64 一支）：
#     #elif defined(__aarch64__)
#             const char *arch = "/registry.aarch64.bin";
#
# 【上游对照】ValveSoftware/wine proton_10.0 分支 dlls/winegstreamer/unixlib.c
#   第 294~300 行原样：
#     #if defined(__x86_64__)
#             const char *arch = "/registry.x86_64.bin";
#     #elif defined(__i386__)
#             const char *arch = "/registry.i386.bin";
#     #elif defined(__aarch64__)
#             const char *arch = "/registry.aarch64.bin";
#     #else
#     #error Bad arch
#     #endif
#   （wine 上游 master 已把整段 WINE_GST_REGISTRY_DIR 处理删除；此处采用
#   Valve proton_10.0 的最小回移方案，行为与 proton_10.0 逐字一致。）
#
# 【适用范围】仅 proton_9.0 形态树命中；proton_10.0+/hangover/official 树
#   已有 aarch64 分支（recipe 门控自动跳过），补丁本身为纯增行、即使误用
#   也只会成为已应用补丁的 no-op。

diff --git a/dlls/winegstreamer/unixlib.c b/dlls/winegstreamer/unixlib.c
--- a/dlls/winegstreamer/unixlib.c
+++ b/dlls/winegstreamer/unixlib.c
@@ -281,6 +281,8 @@ NTSTATUS wg_init_gstreamer(void *arg)
         const char *arch = "/registry.x86_64.bin";
 #elif defined(__i386__)
         const char *arch = "/registry.i386.bin";
+#elif defined(__aarch64__)
+        const char *arch = "/registry.aarch64.bin";
 #else
 #error Bad arch
 #endif
