#!/data/data/com.anwind/files/usr/bin/sh
# ============================================================
# anwind-debfix v5 — 把官方仓库 deb 重打包为 AnWind 前缀
# ============================================================
# 官方 deb 按 /data/data/com.termux 前缀构建（tar 成员路径即绝对
# 路径），不重写 dpkg 会把文件解到别的应用的数据目录。
#
# 原理: dpkg-deb -R 解包 → anwind-reprefix --tree 等长改写
#       （目录名/文件内容/链接目标，com.termux→com.anwind 同为
#       10 字节）→ dpkg-deb -b 原子回写。等长替换不改变任何文件
#       大小，md5sums 中的哈希仍与改前内容一致。
#
# v5（fix8.3）引擎级收口：
#   1) 验收/记账快检 grep 从 data/data/com.termux 收紧为任意
#      com.termux 成员（匹配更严，成本不变——grep -m1 命中即停）；
#   2) 重写完成后调用 anwind-reprefix --verify 独立复检树中残留，
#      引擎的一切静默失效（部分失败/只读文件跳过）在此显形；
#   3) anwind-debfix version 子命令：设备端一键核验部署状态；
#   4) 成功摘要行带版本号，任何一次重写日志都能证明新 APK 在跑。
#
# v4（fix8.2）记账免疫：命中记账也快检成员（dpkg-deb -c 流式 + grep
#   -m1，官方 deb 的 com.termux 条目在 tar 前部秒停），残留即视为
#   历史污染章强制重跑。根因闭环：v2 静默失败盖章 → apt 缓存复用
#   （官方 deb mtime 恒定）→ 记账命中跳过 → 同一批包永远失败且无提示。
#
# v3（fix8.1）加固——全部静默失败路径改为 fail-loud + 可重试：
#   1) dpkg-deb -b 重建失败：旧版静默继续并【盖章】（污染记账，
#      该 deb 永远不再重写，安装永远失败且无任何提示）——现改为
#      报错 + 不盖章，下次调用自动重试；
#   2) 成品验收：重建后的 deb 用 dpkg-deb -c 复查成员，仍含
#      com.termux 成员则不替换不盖章；
#   3) 目录改名降级保底：reprefix 缺失/执行失败/静默失效（count=0
#      但树中仍有 com.termux）时，至少把官方前缀目录改名——dpkg
#      报 unable to stat 的正是这个目录成员，改名后 unpack 即可通过；
#   4) 盖章规则：只有【确认成品无官方前缀成员】才盖章。
#
# v2（fix7）改进：anwind-reprefix 缺失/执行失败时一律 return 1
#   且【不写 stamp】（v1 在 count=0 时照常盖章，会把未重写的 deb
#   永久标记为已处理）；新增 sync_dpkg_real（dpkg 包自升级时把
#   树中已重写的新真身原子刷入 libexec/anwind/dpkg.real）。
#
# 用法:
#   anwind-debfix <deb...>   手工转换（dpkg -i 前手动调用）
#   (无参数)                 从 stdin 读 deb 路径（供钩子使用）
# 幂等：按 文件名+大小+mtime 记账，重复调用直接跳过。
# ============================================================
set -u

# 版本指纹（v5，设备端一键核验部署状态）：anwind-debfix version
if [ "${1:-}" = "version" ]; then
    echo "anwind-debfix v5 (fix8.3, EXTRAS_REVISION 8)"
    exit 0
fi

PREFIX=/data/data/com.anwind/files/usr
REPREFIX=$PREFIX/bin/anwind-reprefix
STAMP_DIR=$PREFIX/var/lib/anwind/debfix
REAL_DPKG=$PREFIX/libexec/anwind/dpkg.real
mkdir -p "$STAMP_DIR" 2>/dev/null

is_elf() { # $1=文件 — 输出 0/1
    [ -f "$1" ] || return 1
    [ "$(head -c 4 "$1" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')" = "7f454c46" ]
}

# dpkg 包自升级：把重写树中的新 dpkg 真身同步为 dpkg.real
sync_dpkg_real() {
    new="$1"
    is_elf "$new" || return 0
    d=$(dirname "$REAL_DPKG")
    mkdir -p "$d" 2>/dev/null
    cp -f "$new" "$REAL_DPKG.tmp.$$" 2>/dev/null || return 0
    chmod 700 "$REAL_DPKG.tmp.$$" 2>/dev/null
    if [ -f "$REAL_DPKG" ]; then
        cp -f "$REAL_DPKG" "$REAL_DPKG.old" 2>/dev/null
    fi
    mv -f "$REAL_DPKG.tmp.$$" "$REAL_DPKG" 2>/dev/null
    return 0
}

process_one() {
    deb="$1"
    [ -f "$deb" ] || return 0
    case "$deb" in
        *.deb) ;;
        *) return 0 ;;
    esac
    base=$(basename "$deb")
    size=$(stat -c %s "$deb" 2>/dev/null || echo 0)
    mtime=$(stat -c %Y "$deb" 2>/dev/null || echo 0)
    stamp="$STAMP_DIR/$base.$size.$mtime"
    if [ -f "$stamp" ]; then
        # v4 记账免疫 + v5 收紧：命中也快检成员。历史污染章（v2 静默
        # 失败时代盖的）+ apt 缓存复用（官方 deb mtime 恒定）曾构成死
        # 闭环——同一批包永远跳过重写、永远安装失败且无提示。快检用
        # dpkg-deb -c 流式列成员；v5 起匹配任意 com.termux 成员（更严）。
        if ! dpkg-deb -c "$deb" 2>/dev/null | grep -m1 -qE 'com\.termux'; then
            return 0
        fi
        echo "anwind-debfix: 警告: $base 已有记账但仍含官方前缀成员（历史污染章），强制重跑" >&2
        rm -f "$STAMP_DIR/$base."* 2>/dev/null
    fi

    # 前置校验：重写引擎缺失时走降级（目录改名保底），绝不静默盖章
    if [ ! -x "$REPREFIX" ]; then
        echo "anwind-debfix: 警告: anwind-reprefix 不可用，$base 降级为目录改名（内容不改写）" >&2
    fi

    work=$(mktemp -d "$STAMP_DIR/work.XXXXXX") || {
        echo "anwind-debfix: 错误: mktemp 失败（磁盘满/权限），$base 未处理（不盖章）" >&2
        return 1
    }
    if ! dpkg-deb -R "$deb" "$work/root" 2>/dev/null; then
        echo "anwind-debfix: 警告: dpkg-deb -R 解包失败，$base 未重写（不盖章，下次重试）" >&2
        rm -rf "$work"
        return 1
    fi
    count=0
    if [ -x "$REPREFIX" ]; then
        if ! count=$("$REPREFIX" --tree "$work/root" 2>/dev/null); then
            count=0
            echo "anwind-debfix: 警告: anwind-reprefix 执行失败，$base 降级为目录改名" >&2
        fi
    fi
    # 目录改名降级保底（v4）：reprefix 正常时上面已把 com.termux 改名，
    # 本条件不成立；reprefix 缺失/失败/静默失效时这里把官方前缀目录
    # 改名——dpkg 报 unable to stat 的正是这个目录成员，改名后 unpack
    # 即可通过。文件内容里的 com.termux 由 reprefix 安全网后续处理。
    if [ -d "$work/root/data/data/com.termux" ] && [ ! -d "$work/root/data/data/com.anwind" ]; then
        if mv "$work/root/data/data/com.termux" "$work/root/data/data/com.anwind" 2>/dev/null; then
            count=$((count + 1))
            echo "anwind-debfix: $base 已降级改写前缀目录" >&2
        else
            echo "anwind-debfix: 错误: $base 目录改名失败，未重写（不盖章）" >&2
            rm -rf "$work"
            return 1
        fi
    fi
    # 全树残余改名（v4）：任何名字含 com.termux 的目录/文件（含前缀目录
    # 改名前 walk 漏掉的深层条目）一并改名，-depth 先子后父防路径失效
    find "$work/root" -depth -name "*com.termux*" 2>/dev/null | while IFS= read -r p; do
        np=$(printf '%s' "$p" | sed 's/com\.termux/com.anwind/g')
        mv "$p" "$np" 2>/dev/null || true
    done
    # 重写引擎复检（v5）：--verify 独立统计树中残留的 com.termux
    # （目录/文件名+链接目标+文件内容）。设备端重写引擎的一切静默
    # 失效（段错误被吞/部分失败/只读文件跳过）在此显形：路径残留
    # 会被下方验收/守卫拦截，内容残留则大声告警（不影响 unpack）。
    if [ -x "$REPREFIX" ]; then
        left=$("$REPREFIX" --verify "$work/root" 2>/dev/null)
        case "$left" in ''|*[!0-9]*) left=1 ;; esac
        if [ "$left" -gt 0 ]; then
            echo "anwind-debfix: 警告: $base 复检发现 $left 处 com.termux 残留（重写引擎部分失效，请回传本行日志）" >&2
        fi
    fi
    # 维护者脚本权限归一（dpkg-deb -b 要求 preinst/postinst/prerm/postrm
    # 权限在 0555-0775 之间；社区 deb 常有 644 的脚本会直接被打包拒绝）
    if [ -d "$work/root/DEBIAN" ]; then
        for s in "$work/root/DEBIAN"/*; do
            [ -f "$s" ] || continue
            case "$(basename "$s")" in
                preinst|postinst|prerm|postrm) chmod 0755 "$s" 2>/dev/null ;;
                *)                             chmod 0644 "$s" 2>/dev/null ;;
            esac
        done
    fi
    # dpkg 包自升级：同步新真身到 dpkg.real（在 dpkg.real 运行前，安全）
    sync_dpkg_real "$work/root/data/data/com.anwind/files/usr/bin/dpkg"
    if [ "$count" -gt 0 ]; then
        if ! dpkg-deb -b "$work/root" "$work/out.deb" >/dev/null 2>&1; then
            echo "anwind-debfix: 错误: dpkg-deb -b 重建失败，$base 未重写（不盖章，下次重试）" >&2
            rm -rf "$work"
            return 1
        fi
        # 成品验收（v3 + v5 收紧）：重建 deb 复查成员，仍含官方前缀
        # 则不替换不盖章。v5 起匹配任意 com.termux 成员（更严）。
        if dpkg-deb -c "$work/out.deb" 2>/dev/null | grep -m1 -qE 'com\.termux'; then
            echo "anwind-debfix: 错误: $base 重建后仍含 com.termux 成员（不盖章，下次重试）" >&2
            rm -rf "$work"
            return 1
        fi
        if ! mv -f "$work/out.deb" "$deb" 2>/dev/null; then
            echo "anwind-debfix: 错误: $base 回写失败（磁盘/权限），不盖章" >&2
            rm -rf "$work"
            return 1
        fi
    else
        # 树中已无官方前缀（含降级后仍无目录的包）：无需重建，直接盖章
        if [ -d "$work/root/data/data/com.termux" ]; then
            echo "anwind-debfix: 错误: $base 树中仍残留 com.termux 且 count=0（不盖章）" >&2
            rm -rf "$work"
            return 1
        fi
    fi
    : > "$stamp"
    # 成品章（v4）：处理后 size+mtime 变化，同文件重复调用（如手动
    # dpkg -i 同一 deb）时官方章不命中会导致反复重建——补盖成品章，
    # 双章并存：官方章供 apt 缓存复用官方原件场景，成品章供重复调用。
    size2=$(stat -c %s "$deb" 2>/dev/null || echo 0)
    mtime2=$(stat -c %Y "$deb" 2>/dev/null || echo 0)
    if [ "$size2.$mtime2" != "$size.$mtime" ]; then
        : > "$STAMP_DIR/$base.$size2.$mtime2"
    fi
    echo "anwind-debfix v5: $base 已重写为 com.anwind 前缀 (count=$count)" >&2
    rm -rf "$work"
    return 0
}

rc=0
if [ $# -gt 0 ]; then
    for d in "$@"; do process_one "$d" || rc=1; done
else
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        process_one "$d" || rc=1
    done
fi
exit $rc
