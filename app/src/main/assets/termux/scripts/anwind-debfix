#!/data/data/com.anwind/files/usr/bin/sh
# ============================================================
# anwind-debfix v2 — 把官方仓库 deb 重打包为 AnWind 前缀
# ============================================================
# 官方 deb 按 /data/data/com.termux 前缀构建（tar 成员路径即绝对
# 路径），不重写 dpkg 会把文件解到别的应用的数据目录。
#
# 原理: dpkg-deb -R 解包 → anwind-reprefix --tree 等长改写
#       （目录名/文件内容/链接目标，com.termux→com.anwind 同为
#       10 字节）→ dpkg-deb -b 原子回写。等长替换不改变任何文件
#       大小，md5sums 中的哈希仍与改前内容一致。
#
# v2（fix7）改进：
#   1) anwind-reprefix 缺失/执行失败时一律 return 1 且【不写 stamp】
#      ——v1 在 count=0 时照常盖章，会把未重写的 deb 永久标记为
#      已处理（盖章污染），导致该 deb 后续安装必然 Permission
#      denied 且不再自动重试；
#   2) 新增 sync_dpkg_real：处理 dpkg 包自身的 deb 时，把树中
#      已重写前缀的新 dpkg 真身原子同步到 libexec/anwind/dpkg.real
#      （此时 dpkg.real 未运行，替换安全）——保证 dpkg 包升级后
#      dpkg.real 始终保持最新版本，bin/dpkg 包装器自愈后不会
#      回退到旧版 dpkg。
#
# 用法:
#   anwind-debfix <deb...>   手工转换（dpkg -i 前手动调用）
#   (无参数)                 从 stdin 读 deb 路径（供钩子使用）
# 幂等：按 文件名+大小+mtime 记账，重复调用直接跳过。
# ============================================================
set -u

PREFIX=/data/data/com.anwind/files/usr
REPREFIX=$PREFIX/bin/anwind-reprefix
STAMP_DIR=$PREFIX/var/lib/anwind/debfix
REAL_DPKG=$PREFIX/libexec/anwind/dpkg.real
mkdir -p "$STAMP_DIR" 2>/dev/null

is_elf() { # $1=文件 — 输出 0/1
    [ -f "$1" ] || return 1
    [ "$(head -c 4 "$1" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')" = "7f454c46" ]
}

# dpkg 包自升级：把重写树中的新 dpkg 真身同步为 dpkg.real
sync_dpkg_real() {
    new="$1"
    is_elf "$new" || return 0
    d=$(dirname "$REAL_DPKG")
    mkdir -p "$d" 2>/dev/null
    cp -f "$new" "$REAL_DPKG.tmp.$$" 2>/dev/null || return 0
    chmod 700 "$REAL_DPKG.tmp.$$" 2>/dev/null
    if [ -f "$REAL_DPKG" ]; then
        cp -f "$REAL_DPKG" "$REAL_DPKG.old" 2>/dev/null
    fi
    mv -f "$REAL_DPKG.tmp.$$" "$REAL_DPKG" 2>/dev/null
    return 0
}

process_one() {
    deb="$1"
    [ -f "$deb" ] || return 0
    case "$deb" in
        *.deb) ;;
        *) return 0 ;;
    esac
    base=$(basename "$deb")
    size=$(stat -c %s "$deb" 2>/dev/null || echo 0)
    mtime=$(stat -c %Y "$deb" 2>/dev/null || echo 0)
    stamp="$STAMP_DIR/$base.$size.$mtime"
    [ -f "$stamp" ] && return 0
    rm -f "$STAMP_DIR/$base."* 2>/dev/null

    # 前置校验：重写引擎必须可用（缺失时绝不盖章，下次调用可重试）
    if [ ! -x "$REPREFIX" ]; then
        echo "anwind-debfix: anwind-reprefix 不可用，$base 未重写（不盖章）" >&2
        return 1
    fi

    work=$(mktemp -d "$STAMP_DIR/work.XXXXXX") || return 1
    if ! dpkg-deb -R "$deb" "$work/root" 2>/dev/null; then
        rm -rf "$work"
        return 1
    fi
    count=$("$REPREFIX" --tree "$work/root" 2>/dev/null)
    if [ $? -ne 0 ]; then
        echo "anwind-debfix: anwind-reprefix 执行失败，$base 未重写（不盖章）" >&2
        rm -rf "$work"
        return 1
    fi
    # 维护者脚本权限归一（dpkg-deb -b 要求 preinst/postinst/prerm/postrm
    # 权限在 0555-0775 之间；社区 deb 常有 644 的脚本会直接被打包拒绝）
    if [ -d "$work/root/DEBIAN" ]; then
        for s in "$work/root/DEBIAN"/*; do
            [ -f "$s" ] || continue
            case "$(basename "$s")" in
                preinst|postinst|prerm|postrm) chmod 0755 "$s" 2>/dev/null ;;
                *)                             chmod 0644 "$s" 2>/dev/null ;;
            esac
        done
    fi
    # dpkg 包自升级：同步新真身到 dpkg.real（在 dpkg.real 运行前，安全）
    sync_dpkg_real "$work/root/data/data/com.anwind/files/usr/bin/dpkg"
    if [ "$count" -gt 0 ]; then
        if dpkg-deb -b "$work/root" "$work/out.deb" >/dev/null 2>&1; then
            mv -f "$work/out.deb" "$deb"
        fi
    fi
    : > "$stamp"
    rm -rf "$work"
    return 0
}

rc=0
if [ $# -gt 0 ]; then
    for d in "$@"; do process_one "$d" || rc=1; done
else
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        process_one "$d" || rc=1
    done
fi
exit $rc
