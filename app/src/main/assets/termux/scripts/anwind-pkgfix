#!/data/data/com.anwind/files/usr/bin/sh
# anwind-pkgfix — pkg/apt 动态库链接离线自愈 v1.0（fix9.9）
# ============================================================
# 背景（fix9.9 排查实锤）：
#   1) bootstrap 归档（2022.01.07-r1）把 libexpat.so /
#      libgpg-error.so 以 dev 名作为真实文件入库，SYMLINKS.txt 缺少
#      对应 soname 条目 → usr/lib 里 libexpat.so.1 /
#      libgpg-error.so.0 从不存在；而 dpkg status 又把 libexpat
#      登记为已安装，pkg install dbus 等依赖方永远不会再解包它们
#      → 结构性死锁（dbus-daemon 必报 CANNOT LINK libexpat.so.1，
#      dbus-launch 尾随费解的 EOF 报错）。
#   2) 历史 dpkg 事故（fix8.6 前）还可能丢失 liblz4.so.1（apt →
#      libapt-pkg.so 的 DT_NEEDED）→ pkg/apt 全灭 → 无法用包管理器
#      自救的死循环（pkg install 任何软件都 CANNOT LINK）。
#
# 本脚本职责（全程离线，不依赖 apt/pkg/网络，幂等可反复执行）：
#   [1/4] 通用 soname 链接自愈：libX.so.N.M[.W] 真实文件存在而
#         libX.so.N 缺失 → 补相对符号链接（绝不覆盖已有文件）；
#   [2/4] dev 名特例映射：libexpat.so→libexpat.so.1、
#         libgpg-error.so→libgpg-error.so.0（bootstrap 打包缺陷）；
#   [3/4] 救援库兜底：liblz4.so.1 / libexpat.so.1 /
#         libgpg-error.so.0 连真身都缺失时，从 etc/anwind/rescue/
#         （AnWind APK 内置副本，打开 App 自动部署）复制补齐；
#   [4/4] 链接实测：apt-get/apt/dpkg/dpkg-deb/dbus-daemon/curl 及
#         xfce4 组件逐个 --version 实跑，报告 PASS/FAIL 与缺失库。
#
# 用法：anwind-pkgfix [-q]   （-q/--quiet 静默，供 anwind-x11 自动调用）
#       输出同时落盘 var/lib/anwind/pkgfix.log（终端无关的地面真相）
# ============================================================

PREFIX=/data/data/com.anwind/files/usr
LIB=$PREFIX/lib
RESCUE=$PREFIX/etc/anwind/rescue
LOGDIR=$PREFIX/var/lib/anwind
LOGFILE=$LOGDIR/pkgfix.log

QUIET=0
if [ "${1:-}" = "-q" ] || [ "${1:-}" = "--quiet" ]; then
    QUIET=1
fi

# 动态库解析兜底（对齐 anwind-dpkg，防异常入口环境缺失）
case ":${LD_LIBRARY_PATH:-}:" in
    *":$PREFIX/lib:"*) : ;;
    *) export LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
esac

mkdir -p "$LOGDIR" 2>/dev/null

say() {
    [ "$QUIET" -eq 1 ] || echo "$1"
    printf '%s pkgfix: %s\n' "$(date '+%m-%d %H:%M:%S' 2>/dev/null || echo '?')" "$1" \
        >> "$LOGFILE" 2>/dev/null || :
}

_fixed=0

say "==== anwind-pkgfix v1.0（fix9.9）动态库链接离线自愈 ===="

# ---- [1/4] 通用 soname 链接自愈 ------------------------------------
# 真实文件 libX.so.N.M / libX.so.N.M.W 存在而短名 libX.so.N 缺失时补
# 相对符号链接。跳过：链接名已存在（含悬空链接）、非真实文件、
# 单段版本名（Termux 包常直接以 soname 命名，如 libssl.so.3）。
say "[1/4] 通用 soname 链接自愈（libX.so.N.M[.W] → libX.so.N）"
for f in "$LIB"/lib*.so.*.*; do
    [ -f "$f" ] || continue          # glob 未命中时为字面量，防御
    [ -L "$f" ] && continue          # 只处理真实文件
    b=${f##*/}                       # 例：liblz4.so.1.9.3
    case "$b" in
        *.so.*.*) : ;;
        *) continue ;;               # 需两段以上版本号
    esac
    base=${b%%.so.*}                 # liblz4
    ver=${b#*.so.}                   # 1.9.3
    first=${ver%%.*}                 # 1
    case "$first" in
        ""|*[!0-9]*) continue ;;     # 版本首段非纯数字（如 -2.1），跳过
    esac
    short="$base.so.$first"          # liblz4.so.1
    [ "$short" = "$b" ] && continue  # 防御：不应发生
    if [ -e "$LIB/$short" ] || [ -L "$LIB/$short" ]; then
        continue
    fi
    if ln -s "$b" "$LIB/$short" 2>/dev/null; then
        say "  [链] $short → $b"
        _fixed=$((_fixed + 1))
    fi
done

# ---- [2/4] dev 名特例映射（bootstrap 打包缺陷修补） ----------------
# bootstrap 把这两个库的 dev 名当真实文件入库且 SYMLINKS.txt 无条目；
# 旧库文件符号集是新依赖方的子集，补上 soname 链接即可被动态链接器
# 按 DT_NEEDED 名字找到。之后用 pkg reinstall 摆正数据库（见结论）。
fix_devname() {                      # fix_devname <dev 名> <soname>
    _fd_d="$1"; _fd_s="$2"
    if [ ! -f "$LIB/$_fd_d" ]; then return 0; fi
    if [ -e "$LIB/$_fd_s" ] || [ -L "$LIB/$_fd_s" ]; then return 0; fi
    if ln -s "$_fd_d" "$LIB/$_fd_s" 2>/dev/null; then
        say "  [链] $_fd_s → $_fd_d"
        _fixed=$((_fixed + 1))
    fi
}
say "[2/4] dev 名真实文件特例映射（bootstrap 缺陷修补）"
fix_devname libexpat.so libexpat.so.1
fix_devname libgpg-error.so libgpg-error.so.0

# ---- [3/4] 救援库兜底 ----------------------------------------------
# 连真实文件都缺失（dpkg 事故整文件丢失）时，从 APK 部署的救援副本
# 复制真身再建链。救援副本由 AnWind 主界面（EXTRAS rev19）自动部署。
rescue_lib() {                       # rescue_lib <真实文件名> <soname>
    _rl_r="$1"; _rl_s="$2"
    if [ -e "$LIB/$_rl_s" ] || [ -L "$LIB/$_rl_s" ]; then return 0; fi
    if [ ! -f "$LIB/$_rl_r" ] && [ -f "$RESCUE/$_rl_r" ]; then
        if cp -f "$RESCUE/$_rl_r" "$LIB/$_rl_r" 2>/dev/null; then
            chmod 644 "$LIB/$_rl_r" 2>/dev/null
            say "  [救] 真身 $_rl_r 已从救援库补齐"
            _fixed=$((_fixed + 1))
        fi
    fi
    if [ ! -f "$LIB/$_rl_r" ]; then return 0; fi
    if ln -s "$_rl_r" "$LIB/$_rl_s" 2>/dev/null; then
        say "  [链] $_rl_s → $_rl_r"
        _fixed=$((_fixed + 1))
    fi
}
say "[3/4] 救援库兜底（$RESCUE）"
if [ ! -d "$RESCUE" ]; then
    say "  （救援目录不存在 —— 打开一次 AnWind 主界面即自动部署）"
fi
rescue_lib liblz4.so.1.9.3 liblz4.so.1
rescue_lib libexpat.so libexpat.so.1
rescue_lib libgpg-error.so libgpg-error.so.0

# ---- [4/4] 链接实测 -------------------------------------------------
# 动态链接先于参数解析：--version 实跑即可安全探测（无副作用）。
verify_bin() {                       # verify_bin <bin 名>
    _vb="$1"
    [ -x "$PREFIX/bin/$_vb" ] || return 0
    if command -v timeout >/dev/null 2>&1; then
        _vb_out="$(timeout 8 "$PREFIX/bin/$_vb" --version 2>&1)" || true
    else
        _vb_out="$("$PREFIX/bin/$_vb" --version 2>&1)" || true
    fi
    case "$_vb_out" in
        *"CANNOT LINK"*|*"not found: needed by"*|*"cannot locate symbol"*)
            _vb_miss="$(printf '%s\n' "$_vb_out" | \
                sed -n 's/.*library "\([^"]*\)" not found.*/\1/p' | head -n 1)"
            say "  [FAIL] $_vb 无法链接（缺 ${_vb_miss:-未知库/符号}）"
            _fail=$((_fail + 1))
            ;;
        *)
            say "  [PASS] $_vb"
            ;;
    esac
}
say "[4/4] 动态链接实测（--version 实跑验证）"
_fail=0
for _b in apt-get apt dpkg dpkg-deb dbus-daemon curl xfwm4 xfce4-panel xfdesktop; do
    verify_bin "$_b"
done

# ---- 结论与后续指引 -------------------------------------------------
say ""
if [ "$_fail" -eq 0 ]; then
    say "结论：全部通过（本轮补建 $_fixed 处）。"
    say "建议接着执行（把 dpkg 数据库与实际文件摆正，防复发）："
    say "  pkg reinstall liblz4 libexpat libgpg-error"
    say "  pkg upgrade"
    say "  anwind-x11 :1    # 重跑 X11 桌面"
    exit 0
else
    say "结论：仍有 $_fail 项无法链接。"
    say "→ 缺 liblz4.so.1 / libexpat.so.1 / libgpg-error.so.0 且真身丢失："
    say "  打开一次 AnWind 主界面（自动部署救援库）后重跑 anwind-pkgfix；"
    say "→ apt-get 已 PASS 时：直接 pkg install <对应包>（anwind-x11 会给包名）；"
    say "→ 完整诊断日志：cat $LOGFILE"
    exit 1
fi
