#!/data/data/com.anwind/files/usr/bin/sh
# anwind-dpkg — AnWind dpkg 包装器 v2（fix7：dpkg 自升级免疫）
# ============================================================
# 官方仓库的 deb 全部按 /data/data/com.termux 前缀构建（tar 成员
# 路径即绝对路径 data/data/com.termux/...），dpkg 以 instdir=/
# 按成员路径落盘——不重写就会写进别的应用的数据目录（报错表现为
# unable to stat './data/data/com.termux': Permission denied）。
#
# fix6 的缺陷：包装器只部署在 bin/dpkg 一处。dpkg 包自升级时，
# deb 里的 bin/dpkg 真身 ELF 会覆盖 bin/dpkg（包装器脚本）——
# 此后 apt/pkg 全部绕过 deb 重打包，pkg update / pkg install
# 全线失败。这正是 v2.22.1 用户实测复现的故障链：
#   tar 升级成功 → dpkg 自升级成功（包装器被杀）→ findutils 失败
#   → 之后所有安装失败。
#
# fix7 三层布局（对 dpkg 包自升级免疫）：
#   libexec/anwind/dpkg       包装器本体。libexec/anwind 不属于任何
#                             软件包，任何升级都不会覆盖；apt 经
#                             apt.conf.d/99anwind 的 Dir::Bin::dpkg
#                             固定调用这里（由安装器写入）；
#   libexec/anwind/dpkg.real  dpkg 真身。anwind-debfix 在 dpkg 包
#                             自升级时自动把新真身同步到这里；
#   bin/dpkg                  包装器副本，供用户直接调用。若被 dpkg
#                             升级覆盖为真身 ELF，本包装器会在运行
#                             前后自愈：先把新真身提升为 dpkg.real
#                             （保持版本最新），再原子恢复包装器副本。
#
# 本包装器职责：
#   0) 自愈 bin/dpkg（见上）；
#   1) 参数中的 *.deb 先经 anwind-debfix 重打包为 com.anwind 前缀；
#   2) 真正的 dpkg（dpkg.real）执行；
#   3) 返回后再自愈一次（本次若装了 dpkg 包，副本刚被覆盖）并运行
#      anwind-reprefix 增量重写（安全网：修补任何未覆盖到的内容）。
# 覆盖范围：apt / pkg / 直接 dpkg -i / grun-install 等全部路径。
# ============================================================

PREFIX=/data/data/com.anwind/files/usr
REAL=$PREFIX/libexec/anwind/dpkg.real
WRAP=$PREFIX/libexec/anwind/dpkg
BIN=$PREFIX/bin/dpkg
FIX=$PREFIX/bin/anwind-debfix
REPREFIX=$PREFIX/bin/anwind-reprefix

# 包装器本体优先（apt 经 Dir::Bin::dpkg 调用时 $0 即本体；
# 用户经 bin/dpkg 调用时 $0 是副本，恢复动作以本体为模板）
SELF=$0
if [ -f "$WRAP" ]; then SELF=$WRAP; fi

# 原子恢复 bin/dpkg 为包装器副本（cp 到临时文件再 mv，不破坏正在
# 执行的旧 inode）
heal_bin_dpkg() {
    [ -f "$SELF" ] || return 0
    if ! cmp -s "$SELF" "$BIN" 2>/dev/null; then
        cp -f "$SELF" "$BIN.tmp.$$" 2>/dev/null \
            && chmod 700 "$BIN.tmp.$$" 2>/dev/null \
            && mv -f "$BIN.tmp.$$" "$BIN" 2>/dev/null
    fi
}

# ---- 自愈（运行前）：bin/dpkg 若被 dpkg 升级覆盖为真身 ELF ----
# 先把新真身提升为 dpkg.real（仅当比现有 dpkg.real 新时），保证
# dpkg.real 始终是最新版本，再恢复包装器副本。
if [ -f "$BIN" ]; then
    magic=$(head -c 4 "$BIN" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')
    if [ "$magic" = "7f454c46" ]; then
        if [ ! -f "$REAL" ] || [ "$BIN" -nt "$REAL" ]; then
            cp -f "$BIN" "$REAL.tmp.$$" 2>/dev/null \
                && chmod 700 "$REAL.tmp.$$" 2>/dev/null \
                && mv -f "$REAL.tmp.$$" "$REAL" 2>/dev/null
        fi
        heal_bin_dpkg
    fi
else
    heal_bin_dpkg
fi

# ---- path-exclude / force-confold 兜底（fix8，缺失才写，幂等）----
# 官方 deb 中漏经 anwind-debfix 重写的 /data/data/com.termux 成员
# （如裸目录条目 ./data/data/com.termux，无尾斜杠）会让 dpkg 报
# "unable to stat ... Permission denied"。path-exclude 让 dpkg 直接
# 跳过这些成员（本就不该落入本应用沙箱）；force-confold 消除配置
# 交互提示。此处保证任何 dpkg 调用路径（apt/pkg/dpkg -i）都带兜底。
_DPKGCFG=$PREFIX/etc/dpkg/dpkg.cfg.d/99-anwind-fix
_APTCFG=$PREFIX/etc/apt/apt.conf.d/99-anwind-fix
if [ ! -f "$_DPKGCFG" ] || [ ! -f "$_APTCFG" ]; then
    mkdir -p "$PREFIX/etc/dpkg/dpkg.cfg.d" "$PREFIX/etc/apt/apt.conf.d" 2>/dev/null
    [ -f "$_DPKGCFG" ] || printf '%s\n' \
        '# AnWind (com.anwind) dpkg 兜底修复（fix8）' \
        '# 跳过官方 deb 中漏经重写的 /data/data/com.termux 成员' \
        '# （如裸目录条目），否则 dpkg 落盘时报 Permission denied。' \
        'path-exclude=/data/data/com.termux' \
        'path-exclude=/data/data/com.termux/*' \
        'force-confold' \
        > "$_DPKGCFG" 2>/dev/null
    [ -f "$_APTCFG" ] || printf '%s\n' \
        '// AnWind (com.anwind) dpkg 兜底修复（fix8）——双保险' \
        '// 即使 etc/dpkg/dpkg.cfg.d/99-anwind-fix 丢失，apt 调起的' \
        '// dpkg 也带同样的 path-exclude / force-confold。' \
        'DPkg::Options:: "--path-exclude=/data/data/com.termux";' \
        'DPkg::Options:: "--path-exclude=/data/data/com.termux/*";' \
        'DPkg::Options:: "--force-confold";' \
        > "$_APTCFG" 2>/dev/null
fi
unset _DPKGCFG _APTCFG

# ---- deb 重打包（com.termux → com.anwind）----
fix_failed=0
for a in "$@"; do
    case "$a" in
        *.deb)
            if [ -f "$a" ]; then
                if [ -x "$FIX" ]; then
                    "$FIX" "$a" || fix_failed=1
                else
                    echo "anwind-dpkg: 警告: anwind-debfix 不可用，$a 未经前缀重写" >&2
                    fix_failed=1
                fi
            fi
            ;;
    esac
done
if [ "$fix_failed" -eq 1 ]; then
    echo "anwind-dpkg: 提示: 部分 deb 未能完成前缀重写，对应包可能安装失败" \
         "（重试 pkg update / 安装命令即可）" >&2
fi

# ---- 真身执行 ----
"$REAL" "$@"
rc=$?

# ---- 自愈（运行后）：本次若升级了 dpkg 包，bin/dpkg 已被覆盖 ----
heal_bin_dpkg

# ---- 安全网：按 dpkg 清单增量重写安装内容 ----
if [ -x "$REPREFIX" ]; then
    "$REPREFIX" --quiet
fi

exit $rc
