#!/data/data/com.anwind/files/usr/bin/sh
# ============================================================
# anwind-tarxz — 解压 tar.xz 并把所有内嵌 com.termux 路径
#                强制改写为 com.anwind（与 pkg 安装时同款引擎）
# ============================================================
# 背景：官方 termux 生态的 rootfs / bootstrap / 打包 tar.xz 把
# /data/data/com.termux 焊死在文件内容里（ELF 的 .rodata、脚本
# shebang、.pc/.cmake 配置、dpkg 数据库……），而 anwind 的数据
# 目录是 /data/data/com.anwind——直接解压必然无法工作。
#
# 原理：com.anwind 与 com.termux 恰好同为 10 字节。解压后调用
# 原生重写引擎 anwind-reprefix --tree 做等长字节替换：
#   - 普通文件内容（mmap 就地改写，不移动 ELF 段偏移，二进制
#     安全；只读权限文件自动临时加写位、改完还原）；
#   - 目录名（data/data/com.termux → data/data/com.anwind 等
#     成员路径目录一并改名）；
#   - 符号链接目标。
# 随后 --verify 复检残留必须为 0。
#
# 特判（与 anwind-debfix v6.3 同策略）：宿主 APK 的 X11 入口类
# 真实类名保持 com.termux.x11.*（Java 包名不随应用包名重前缀），
# 树内的 X11 客户端脚本重写后必然失效，故最后统一换回内置
# 主副本（etc/anwind/x11/termux-x11）。
#
# 解压目录（v2.25 起为正式用法）：
#   默认 = 压缩包同目录 + 去后缀名（无需额外参数）；
#   -t <目录> = 指定任意解压目标（相对/绝对路径均可，自动归一）。
#   注意：/sdcard、/storage/emulated 等共享存储是 FUSE 文件系统，
#   不支持符号链接/权限位——rootfs / bootstrap 类压缩包解到那里
#   必然损坏（ln -s 失败、bin/ 下全是断链）。此类包请务必
#   -t 到 $HOME 或 $PREFIX 下；普通数据包（无符号链接）不受限，
#   脚本只会给出提示而不会拦截。
#
# 用法:
#   anwind-tarxz <archive.tar.xz>             解压到 <去后缀同名目录>/ 并改写
#   anwind-tarxz <archive.tar.xz> -t <目录>   解压到指定目录并改写
#   anwind-tarxz -h | --help                  本帮助
#
# 兼容: *.tar.xz / *.txz（bootstrap 自带 GNU tar + xz，保留
#       权限/符号链接/硬链接）
# ============================================================
set -u

PREFIX=/data/data/com.anwind/files/usr
REPREFIX="$PREFIX/bin/anwind-reprefix"

usage() {
  cat <<'USAGE'
anwind-tarxz — 解压 tar.xz 并强制把所有内嵌 com.termux 路径改写为 com.anwind

用法:
  anwind-tarxz <archive.tar.xz>              解压到 <archive 去后缀>/ 并改写
  anwind-tarxz <archive.tar.xz> -t <目录>    解压到指定目录并改写
  anwind-tarxz -h | --help                   显示本帮助

解压目录:
  - 默认为压缩包同目录下的去后缀同名目录；
  - -t 可指定任意目录（相对/绝对路径均可，自动归一为绝对路径）；
  - 共享存储（/sdcard、/storage/emulated 等）不支持符号链接：
    rootfs/bootstrap 类压缩包请务必 -t 到 $HOME 等本地目录，
    否则 bin/ 下符号链接全部断裂、环境不可用。

说明:
  - 等长字节重写对 ELF / 文本 / 符号链接都安全
    （com.termux 与 com.anwind 同为 10 字节，等效按 com.anwind 重新编译）；
  - tar 成员路径若含 data/data/com.termux（官方 rootfs 常见），
    目录会一并改名为 data/data/com.anwind；
  - 改写完成后 --verify 复检，残留必须为 0，否则非零退出；
  - 树内 bin/termux-x11 会被换回内置客户端（宿主 X11 入口类
    保持 com.termux.x11.*，不可重写）。

示例:
  anwind-tarxz /sdcard/Download/termux-rootfs.tar.xz -t ~/rootfs
  anwind-tarxz bootstrap-arm64.txz -t ~/bootstrap
  anwind-tarxz data-pack.tar.xz                # 普通数据包用默认目录即可
USAGE
}

# 相对路径 → 绝对路径（realpath 优先，缺失时手工拼接）。
abspath() {
  _p="$1"
  case "$_p" in
    /*) ;;
    *) _p="$(pwd)/$_p" ;;
  esac
  if command -v realpath >/dev/null 2>&1; then
    realpath -m "$_p" 2>/dev/null || echo "$_p"
  else
    echo "$_p"
  fi
}

# 目标是否落在共享存储（FUSE：不支持符号链接/权限位）。
is_shared_storage() {
  case "$1" in
    /sdcard/*|/sdcard|/storage/emulated/*|/storage/emulated|/mnt/user/*|/mnt/media_rw/*) return 0 ;;
    *) return 1 ;;
  esac
}

ARCHIVE=""
TARGET=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -t|--to)
      [ $# -ge 2 ] || { echo "anwind-tarxz: -t 需要一个目录参数" >&2; exit 64; }
      TARGET="$2"; shift 2 ;;
    --) shift; break ;;
    -*) echo "anwind-tarxz: 未知选项 $1（-h 查看帮助）" >&2; exit 64 ;;
    *)
      if [ -z "$ARCHIVE" ]; then ARCHIVE="$1"; shift
      else echo "anwind-tarxz: 多余的参数 $1（-h 查看帮助）" >&2; exit 64; fi ;;
  esac
done

[ -n "$ARCHIVE" ] || { usage; exit 64; }
[ -f "$ARCHIVE" ] || { echo "anwind-tarxz: 找不到压缩包 $ARCHIVE" >&2; exit 66; }
[ -x "$REPREFIX" ] || {
  echo "anwind-tarxz: 重写引擎不可用（$REPREFIX 缺失或不可执行，" >&2
  echo "              请先完成 bootstrap 安装/升级后重试）" >&2
  exit 69
}

# 目标目录默认：压缩包同目录 + 去后缀名；-t 指定时归一为绝对路径
if [ -z "$TARGET" ]; then
  _base=$(basename "$ARCHIVE")
  _base=${_base%.tar.xz}; _base=${_base%.txz}; _base=${_base%.tar}; _base=${_base%.xz}
  _dir=$(dirname "$ARCHIVE")
  TARGET="$_dir/$_base"
else
  TARGET=$(abspath "$TARGET")
fi

if is_shared_storage "$TARGET"; then
  echo "anwind-tarxz: 警告: 目标 $TARGET 位于共享存储（FUSE 文件系统）。" >&2
  echo "              共享存储不支持符号链接与权限位：rootfs / bootstrap" >&2
  echo "              类压缩包解到那里必然损坏（bin/ 全是断链）。" >&2
  echo "              rootfs 请改用: anwind-tarxz <$ARCHIVE> -t \$HOME/<目录>" >&2
  echo "              （普通数据包无符号链接，可忽略本警告，继续解压）" >&2
  sleep 2
fi

if [ -e "$TARGET" ] && [ -n "$(ls -A "$TARGET" 2>/dev/null)" ]; then
  echo "anwind-tarxz: 目标目录 $TARGET 非空，为避免与旧内容混淆，" >&2
  echo "              请先清空它或用 -t 指定一个空目录" >&2
  exit 73
fi
mkdir -p "$TARGET" 2>/dev/null || { echo "anwind-tarxz: 无法创建 $TARGET" >&2; exit 73; }

echo "==> [1/4] 解压 $(basename "$ARCHIVE") → $TARGET"
if ! tar -xJf "$ARCHIVE" -C "$TARGET"; then
  echo "anwind-tarxz: 解压失败（xz 数据损坏 / 磁盘或内存不足；" >&2
  echo "              若含设备节点等特殊文件，GNU tar 会部分报错，请检查上方输出）" >&2
  exit 74
fi

echo "==> [2/4] 强制改写内嵌路径 com.termux → com.anwind（等长重写，ELF 安全）"
CHANGES=$("$REPREFIX" --tree "$TARGET")
if [ $? -ne 0 ]; then
  echo "anwind-tarxz: 树内存在改名失败的残留目录（见上方错误），已中止。" >&2
  echo "              修复权限后重跑本命令即可（对已解压内容幂等）。" >&2
  exit 1
fi
echo "    改动 $CHANGES 处（文件内容 + 目录名 + 符号链接目标）"

echo "==> [3/4] 复检残留（必须为 0）"
RESIDUAL=$("$REPREFIX" --verify "$TARGET")
if [ "$RESIDUAL" != "0" ]; then
  echo "anwind-tarxz: 警告: 复检仍有 $RESIDUAL 处 com.termux 残留" >&2
  echo "              （异常权限/文件名残留？请检查后手动处理）" >&2
  exit 2
fi

echo "==> [4/4] X11 客户端特判（宿主入口类保持 com.termux.x11.*，不可重写）"
X11_MASTER="$PREFIX/etc/anwind/x11/termux-x11"
if [ -f "$X11_MASTER" ]; then
  find "$TARGET" -type f -name "termux-x11" 2>/dev/null | while IFS= read -r _f; do
    if cp -f "$X11_MASTER" "$_f" 2>/dev/null && chmod 0755 "$_f" 2>/dev/null; then
      echo "    已换回内置客户端: $_f"
    else
      echo "    警告: 替换失败（保留原文件）: $_f" >&2
    fi
  done
else
  echo "    内置主副本缺失，跳过（如树内含官方 X11 客户端，请勿直接使用）"
fi

echo "==> 完成：全部内嵌路径已为 com.anwind → $TARGET"
# 常见布局提示
if [ -d "$TARGET/data/data/com.anwind/files/usr" ]; then
  echo "    检测到官方 rootfs 布局: $TARGET/data/data/com.anwind/files/usr"
elif [ -d "$TARGET/usr" ]; then
  echo "    检测到 usr 布局: $TARGET/usr"
fi
exit 0
